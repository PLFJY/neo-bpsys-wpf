<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ProductTourFallbackTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ProductTourFallbackSubtleTextBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ProductTourFallbackCardBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ProductTourFallbackAccentBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="ProductTourFallbackSecondaryBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ProductTourFallbackMaskBrush" Color="#FF101010" />
    <SolidColorBrush x:Key="ProductTourFallbackErrorBrush" Color="#FFFFB4A8" />
    <SolidColorBrush x:Key="ProductTourSurfaceBrush" Color="#F2292929" />
    <SolidColorBrush x:Key="ProductTourElevatedSurfaceBrush" Color="#F5272727" />
    <SolidColorBrush x:Key="ProductTourOpaqueSurfaceBrush" Color="#FF272727" />

    <Style x:Key="ProductTourOverlayStyle" TargetType="{x:Type Canvas}" />

    <Style x:Key="ProductTourSpotlightStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Opacity="0.55"
                    ShadowDepth="0"
                    Color="#5560CDFF" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProductTourElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="16"
                    Opacity="0.35"
                    ShadowDepth="2"
                    Color="#66000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourCardTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourCardDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="ProductTourCardProgressStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style x:Key="ProductTourCardWaitingStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourCardErrorStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource ProductTourFallbackErrorBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="ProductTourArrowPathStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="ProductTourPrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ProductTourSecondaryButtonStyle"
        BasedOn="{StaticResource ProductTourPrimaryButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style
        x:Key="ProductTourSkipButtonStyle"
        BasedOn="{StaticResource ProductTourSecondaryButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="ProductTourWelcomeOverlayStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="{DynamicResource ProductTourFallbackMaskBrush}" />
    </Style>

    <Style
        x:Key="ProductTourWelcomeSurfaceStyle"
        BasedOn="{StaticResource ProductTourCardStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="48,44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProductTourSurfaceBrush}" />
        <Setter Property="MaxWidth" Value="720" />
    </Style>

    <Style
        x:Key="ProductTourWelcomeCardStyle"
        BasedOn="{StaticResource ProductTourWelcomeSurfaceStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="48,44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MaxWidth" Value="720" />
    </Style>

    <Style x:Key="ProductTourWelcomeTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourWelcomeDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
    </Style>

    <Style x:Key="ProductTourWelcomeFootnoteStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style x:Key="ProductTourWelcomeLanguagePanelStyle" TargetType="{x:Type WrapPanel}" />

    <Style
        x:Key="ProductTourWelcomeLanguageComboBoxStyle"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourWelcomeLanguageItemStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ProductTourWelcomeLanguageItemSelectedStyle"
        BasedOn="{StaticResource ProductTourWelcomeLanguageItemStyle}"
        TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="ProductTourAvatarImageStyle" TargetType="{x:Type Image}">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style
        x:Key="ProductTourWelcomeAvatarImageStyle"
        BasedOn="{StaticResource ProductTourAvatarImageStyle}"
        TargetType="{x:Type Image}">
        <Setter Property="Opacity" Value="0.96" />
    </Style>

    <Style
        x:Key="ProductTourDialogueAvatarImageStyle"
        BasedOn="{StaticResource ProductTourAvatarImageStyle}"
        TargetType="{x:Type Image}">
        <Setter Property="Opacity" Value="0.98" />
    </Style>

    <Style
        x:Key="ProductTourCardAvatarImageStyle"
        BasedOn="{StaticResource ProductTourAvatarImageStyle}"
        TargetType="{x:Type Image}">
        <Setter Property="Opacity" Value="0.96" />
    </Style>

    <Style x:Key="ProductTourDialogueOverlayStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="{DynamicResource ProductTourFallbackMaskBrush}" />
    </Style>

    <Style x:Key="ProductTourDialogueBoxStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="24,18" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProductTourSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="18"
                    Opacity="0.4"
                    ShadowDepth="2"
                    Color="#66000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourDialogueSpeakerStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourDialogueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="ProductTourDialogueContinueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style
        x:Key="ProductTourConfirmDialogStyle"
        BasedOn="{StaticResource ProductTourCardStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProductTourOpaqueSurfaceBrush}" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="MaxWidth" Value="520" />
    </Style>

    <Style x:Key="ProductTourConfirmTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourConfirmMessageStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ProductTourFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
</ResourceDictionary>
