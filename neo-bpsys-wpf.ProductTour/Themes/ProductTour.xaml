<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ProductTourFallbackTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ProductTourFallbackSubtleTextBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ProductTourFallbackCardBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ProductTourFallbackAccentBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="ProductTourFallbackSecondaryBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ProductTourFallbackMaskBrush" Color="#CC202020" />

    <Style x:Key="ProductTourOverlayStyle" TargetType="{x:Type Canvas}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="ProductTourSpotlightStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#5560CDFF" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#66000000" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourCardTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourCardDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="ProductTourArrowPathStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="ProductTourPrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourSecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ProductTourPrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="ProductTourSkipButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ProductTourSecondaryButtonStyle}">
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="ProductTourWelcomeOverlayStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="#202020" />
    </Style>

    <Style x:Key="ProductTourWelcomeCardStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource ProductTourCardStyle}">
        <Setter Property="Padding" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MaxWidth" Value="620" />
    </Style>

    <Style x:Key="ProductTourWelcomeTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourWelcomeDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
    </Style>

    <Style x:Key="ProductTourDialogueOverlayStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="#66000000" />
    </Style>

    <Style x:Key="ProductTourDialogueBoxStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="24,18" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MaxWidth" Value="920" />
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#66000000" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProductTourDialogueSpeakerStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ProductTourDialogueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="ProductTourConfirmDialogStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
</ResourceDictionary>
