<controls:FrontedWindowBase
    x:Class="neo_bpsys_wpf.GameStopwatch.Views.GameStopwatchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:neo_bpsys_wpf.Core.Controls;assembly=neo-bpsys-wpf.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeToContent="Height"
    Width="{Binding WindowSize}"
    Background="Transparent"
    AllowsTransparency="True"
    WindowStyle="None"
    ShowInTaskbar="False"
    mc:Ignorable="d">
    <Border Padding="8" Background="Transparent">
        <TextBlock
            FontFamily="{Binding FontFamilyName}"
            FontSize="{Binding FontSize}"
            Foreground="{Binding TextBrush}"
            Text="{Binding DisplayText}"
            TextOptions.TextFormattingMode="Display" />
    </Border>
</controls:FrontedWindowBase>
