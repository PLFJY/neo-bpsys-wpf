<Page
    x:Class="neo_bpsys_wpf.WebRenderer.WebRendererManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:neo_bpsys_wpf.WebRenderer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Web 前台"
    d:DataContext="{d:DesignInstance Type=local:WebRendererManagementViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <local:WebRendererBooleanInverter x:Key="BooleanInverterConverter" />
    </Page.Resources>
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Title}" Text="Web 前台地址" />
            <ui:InfoBadge
                Margin="12,6,0,0"
                Severity="Attention"
                Value="实验性" />
        </StackPanel>

        <Border
            Margin="0,12,0,16"
            Padding="16"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding IsRuntimeMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Symbol="Warning24" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="未检测到 ASP.NET Core Runtime 10 (x64)" />
                </StackPanel>
                <TextBlock
                    Margin="0,8,0,0"
                    Text="Web 前台需要 ASP.NET Core 10 运行时才能运行。点击下方按钮自动下载并安装，安装完成后请重启应用。"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding RuntimeSetupMessage}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RuntimeSetupMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RuntimeSetupMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar
                    Margin="0,8,0,0"
                    Maximum="100"
                    Visibility="{Binding IsRuntimeSetupBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Value="{Binding RuntimeDownloadProgress, Mode=OneWay}" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding DownloadAndInstallRuntimeCommand}"
                        Content="下载并安装"
                        Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding RecheckRuntimeCommand}"
                        Content="重新检测"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding OpenRuntimeDownloadPageCommand}"
                        Content="打开官方下载页"
                        Icon="{ui:SymbolIcon Symbol=Open24}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,8,0,16"
            Text="将下列地址复制到 OBS 的浏览器源。Web 前台与现有 WPF 前台可同时使用。"
            TextWrapping="Wrap" />

        <Border Style="{StaticResource Card}">
            <Grid>
                <ui:ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="{Binding IsWaitingForWindows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding WindowLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:WebRendererWindowLink}">
                            <Border
                                Padding="16,12"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Url}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding ObsHint}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Text="{Binding Diagnostic}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.CopyWindowUrlCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="复制"
                                        Icon="{ui:SymbolIcon Symbol=Copy24}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
            <ui:Button
                Command="{Binding StartCommand}"
                Content="启动 Web 前台"
                Icon="{ui:SymbolIcon Symbol=Play24}"
                IsEnabled="{Binding IsLifecycleOperationRunning, Converter={StaticResource BooleanInverterConverter}}" />
            <ui:Button
                Margin="8,0,0,0"
                Command="{Binding StopCommand}"
                Content="停止"
                Icon="{ui:SymbolIcon Symbol=Stop24}"
                IsEnabled="{Binding IsLifecycleOperationRunning, Converter={StaticResource BooleanInverterConverter}}" />
            <ui:Button
                Margin="8,0,0,0"
                Command="{Binding RestartCommand}"
                Content="重启"
                Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                IsEnabled="{Binding IsLifecycleOperationRunning, Converter={StaticResource BooleanInverterConverter}}" />
            <ui:Button
                Margin="8,0,0,0"
                Command="{Binding OpenUrlCommand}"
                Content="打开窗口列表"
                Icon="{ui:SymbolIcon Symbol=Open24}" />
        </StackPanel>

        <Expander Margin="0,16,0,0" Header="服务与高级设置">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding ServiceState}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding LifecycleOperationText}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding LocalUrl}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding LanUrl}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ClientCount, StringFormat=已连接浏览器：{0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ActivePackageId, StringFormat=当前布局包：{0}}" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="140"
                        VerticalAlignment="Center"
                        Text="监听地址" />
                    <ui:TextBox Width="220" Text="{Binding Host}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="140"
                        VerticalAlignment="Center"
                        Text="端口" />
                    <ui:NumberBox Width="220" Value="{Binding Port}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="140"
                        VerticalAlignment="Center"
                        Text="Exit 超时（毫秒）" />
                    <ui:NumberBox Width="220" Value="{Binding ExitTimeoutMs}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="140"
                        VerticalAlignment="Center"
                        Text="Enter 超时（毫秒）" />
                    <ui:NumberBox Width="220" Value="{Binding EnterTimeoutMs}" />
                </StackPanel>
                <ui:ToggleSwitch
                    Margin="0,8,0,0"
                    Content="随应用启动"
                    IsChecked="{Binding StartWithApplication}" />
                <ui:ToggleSwitch
                    Margin="0,8,0,0"
                    Content="详细协议日志"
                    IsChecked="{Binding LogProtocol}" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding SaveCommand}"
                        Content="保存并重启"
                        Icon="{ui:SymbolIcon Symbol=Save24}"
                        IsEnabled="{Binding IsLifecycleOperationRunning, Converter={StaticResource BooleanInverterConverter}}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding ExportDiagnosticsCommand}"
                        Content="导出诊断"
                        Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                </StackPanel>
                <TextBlock
                    Margin="0,12,0,0"
                    Text="{Binding LastError}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
    </StackPanel>
</Page>
