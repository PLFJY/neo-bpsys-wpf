<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>neo_bpsys_wpf.TeamJsonMaker</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Configurations>Debug;Release;Beta;Preview</Configurations>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="FrontedDefaultPositions\**" />
	  <EmbeddedResource Remove="FrontedDefaultPositions\**" />
	  <None Remove="FrontedDefaultPositions\**" />
	  <Page Remove="FrontedDefaultPositions\**" />
	</ItemGroup>

	<ItemGroup>
		<None Update="manifest.yml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="icon.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\neo-bpsys-wpf.PluginSdk\neo-bpsys-wpf.PluginSdk.csproj" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
	</ItemGroup>

	<Import Project="..\..\neo-bpsys-wpf.PluginSdk\neo-bpsys-wpf.PluginSdk.targets" />
</Project>
