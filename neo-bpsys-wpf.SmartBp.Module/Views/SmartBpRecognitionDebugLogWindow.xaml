<ui:FluentWindow
    x:Class="neo_bpsys_wpf.Views.Windows.SmartBpRecognitionDebugLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:helpers="clr-namespace:neo_bpsys_wpf.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{lex:Loc SmartBpRecognitionDebugLogWindowTitle}"
    Width="1100"
    Height="700"
    MinWidth="760"
    MinHeight="480"
    lex:LocalizeDictionary.Provider="{x:Static helpers:SmartBpLocalizationProvider.Instance}"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf.SmartBp.Module"
    lex:ResxLocalizationProvider.DefaultDictionary="Locales.SmartBp"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{lex:Loc SmartBpRecognitionDebugLogWindowTitle}" />
        <WrapPanel Grid.Row="1" Margin="12,8,12,8">
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding CopyRecognitionDebugLogCommand}"
                Content="{lex:Loc SmartBpCopyRecognitionDebugLog}"
                Icon="{ui:SymbolIcon Symbol=Copy24}" />
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding ClearAiDebugLogCommand}"
                Content="{lex:Loc Clear}"
                Icon="{ui:SymbolIcon Symbol=Delete24}" />
            <ui:Button
                Margin="0,0,8,0"
                Command="{Binding RefreshRecognitionDebugLogCommand}"
                Content="{lex:Loc Refresh}"
                Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
            <ui:ToggleSwitch
                VerticalAlignment="Center"
                Content="{lex:Loc SmartBpRecognitionDebugLogAutoScroll}"
                IsChecked="{Binding IsRecognitionDebugLogAutoScrollEnabled, Mode=TwoWay}" />
        </WrapPanel>
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:DynamicScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{lex:Loc SmartBpDebugStrategySummary}" />
                    <ui:TextBox AcceptsReturn="True" IsReadOnly="True" Text="{Binding DebugStrategySummary}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{lex:Loc SmartBpDebugPhaseScene}" />
                    <ui:TextBox AcceptsReturn="True" IsReadOnly="True" Text="{Binding DebugPhaseScene}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{lex:Loc SmartBpDebugFusionSummary}" />
                    <ui:TextBox AcceptsReturn="True" IsReadOnly="True" Text="{Binding DebugFusionSummary}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{lex:Loc SmartBpDebugCandidateOperations}" />
                    <ui:TextBox AcceptsReturn="True" IsReadOnly="True" Text="{Binding DebugCandidateOperations}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{lex:Loc SmartBpDebugTimingServerSummary}" />
                    <ui:TextBox AcceptsReturn="True" IsReadOnly="True" Text="{Binding DebugServerStatus}" TextWrapping="Wrap" />
                    <ui:TextBox Margin="0,6,0,0" AcceptsReturn="True" IsReadOnly="True" Text="{Binding DebugTiming}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding AiLastError}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:DynamicScrollViewer>
            <ui:TextBox
                x:Name="LogTextBox"
                Grid.Column="2"
                AcceptsReturn="True"
                AcceptsTab="True"
                FontFamily="Consolas"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="{Binding RecognitionDebugLogText}"
                TextChanged="LogTextBox_OnTextChanged"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</ui:FluentWindow>
