<controls:FrontedWindowBase
    x:Class="neo_bpsys_wpf.ExamplePlugin.Views.ExampleXamlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:neo_bpsys_wpf.Core.Controls;assembly=neo-bpsys-wpf.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:neo_bpsys_wpf.ExamplePlugin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:neo_bpsys_wpf.ExamplePlugin.ViewModels"
    Title="ExampleXamlWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=viewModels:ExampleXamlWindowViewModel}"
    mc:Ignorable="d">
    <Canvas
        Name="BaseCanvas"
        Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Width}"
        Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Height}">
        <TextBlock
            Name="HelloWorld"
            Canvas.Left="348"
            Canvas.Top="204"
            HorizontalAlignment="Left"
            FontSize="28"
            Text="Hello World" />
    </Canvas>
</controls:FrontedWindowBase>
