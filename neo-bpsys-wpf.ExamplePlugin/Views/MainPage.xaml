<Page
    x:Class="neo_bpsys_wpf.ExamplePlugin.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:neo_bpsys_wpf.ExamplePlugin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:neo_bpsys_wpf.ExamplePlugin.ViewModels"
    Title="MainPage"
    d:DataContext="{d:DesignInstance Type=viewModels:MainPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Foreground="White"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/neo-bpsys-wpf.Core;component/Styles/Card.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel Margin="10" Orientation="Vertical">
        <Border
            Padding="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="ExamplePlugin - All-in-one Reference Plugin"
                    TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    This example plugin demonstrates all current plugin capabilities:
                    backend page, Plugin XAML window,
                    Plugin v3 Layout window, and Designer v3 plugin control (TeamCard).
                </TextBlock>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="Current count: " /><Run Text="{Binding Counter}" />
                </TextBlock>
                <ui:Button
                    Height="30"
                    Margin="0,8,0,0"
                    d:Content="0"
                    Command="{Binding Plus1Command}"
                    Content="Click Me"
                    Icon="{ui:SymbolIcon Symbol=Add24}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
