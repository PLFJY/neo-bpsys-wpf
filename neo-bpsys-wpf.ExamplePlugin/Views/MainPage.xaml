<Page
    x:Class="neo_bpsys_wpf.ExamplePlugin.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:neo_bpsys_wpf.ExamplePlugin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:neo_bpsys_wpf.ExamplePlugin.ViewModels"
    Title="MainPage"
    d:DataContext="{d:DesignInstance Type=viewModels:MainPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Foreground="White"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/neo-bpsys-wpf.Core;component/Styles/Card.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel Margin="10" Orientation="Vertical">
        <Border
            Padding="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="ExamplePlugin - All-in-one Reference Plugin"
                    TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    This example plugin demonstrates all current plugin capabilities:
                    backend page, Plugin XAML window,
                    Plugin v3 Layout window, Designer v3 plugin controls, and custom Behavior events.
                </TextBlock>
                <TextBlock
                    Margin="0,12,0,0"
                    FontWeight="SemiBold"
                    Text="Designer v3 Behavior event demo" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    Configure a OneShot trigger with
                    ExamplePlugin behavior events / Counter changed.
                    You can filter it with Event.CounterValue == 2.
                    All three events are available to OneShot and Loop triggers;
                    for example, use Start pulse loop as StartTrigger and Stop pulse loop as StopTrigger.
                </TextBlock>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="Current count: " /><Run Text="{Binding Counter}" />
                </TextBlock>
                <WrapPanel Margin="0,8,0,0">
                    <ui:Button
                        Height="30"
                        Margin="0,0,8,8"
                        Command="{Binding Plus1Command}"
                        Content="Increment and publish"
                        Icon="{ui:SymbolIcon Symbol=Add24}" />
                    <ui:Button
                        Height="30"
                        Margin="0,0,8,8"
                        Command="{Binding StartPulseCommand}"
                        Content="Publish loop start"
                        Icon="{ui:SymbolIcon Symbol=Play24}" />
                    <ui:Button
                        Height="30"
                        Margin="0,0,0,8"
                        Command="{Binding StopPulseCommand}"
                        Content="Publish loop stop"
                        Icon="{ui:SymbolIcon Symbol=Stop24}" />
                </WrapPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    FontFamily="Consolas"
                    Text="{Binding LastPublishedEvent}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
