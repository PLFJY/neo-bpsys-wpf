<UserControl
    x:Class="neo_bpsys_wpf.Views.FrontedDesigner.GraphEditor.FrontedNodeGraphEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:neo_bpsys_wpf.Views.FrontedDesigner.GraphEditor"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Designer"
    scrolling:ModernScroll.Ownership="Self"
    Focusable="True"
    PreviewKeyDown="FrontedNodeGraphEditorView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="80" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <ui:Button Command="{Binding DeleteSelectedNodeCommand}" Content="{lex:Loc Designer.Graph.DeleteNode}" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding DuplicateSelectedNodeCommand}"
                Content="{lex:Loc Designer.Graph.DuplicateNode}" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding AutoCreateStartEndCommand}"
                Content="{lex:Loc Designer.Graph.AddStartEnd}" />
            <ui:Button
                Margin="18,0,0,0"
                Command="{Binding RunGraphPreviewCommand}"
                Content="{lex:Loc Designer.Graph.RunPreview}" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding StopPreviewCommand}"
                Content="{lex:Loc Designer.Graph.StopPreview}" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ResetCurrentTargetCommand}"
                Content="{lex:Loc Designer.Graph.ResetCurrentTarget}" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ResetAllPreviewCommand}"
                Content="{lex:Loc Designer.Graph.ResetAllPreview}" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding ValidateGraphCommand}"
                Content="{lex:Loc Designer.Graph.Validate}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                Text="{Binding ConnectionStatus}" />
            <Border
                Width="1"
                Height="20"
                Margin="18,0,0,0"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <ui:Button
                Margin="6,0,0,0"
                Command="{Binding UndoCommand}"
                Content="{lex:Loc Designer.Graph.Undo}"
                Icon="{ui:SymbolIcon Symbol=ArrowUndo24}"
                ToolTip="{lex:Loc Designer.Graph.ToolTipUndo}" />
            <ui:Button
                Margin="4,0,0,0"
                Command="{Binding RedoCommand}"
                Content="{lex:Loc Designer.Graph.Redo}"
                Icon="{ui:SymbolIcon Symbol=ArrowRedo24}"
                ToolTip="{lex:Loc Designer.Graph.ToolTipRedo}" />
            <ui:Button
                Margin="8,0,0,0"
                Command="{Binding SaveCommand}"
                Content="{lex:Loc Designer.Graph.Save}"
                Icon="{ui:SymbolIcon Symbol=Save24}"
                ToolTip="{lex:Loc Designer.Graph.ToolTipSave}" />
        </StackPanel>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="270" MinWidth="160" />
            </Grid.ColumnDefinitions>
            <Border
                Margin="0,0,8,0"
                Padding="8"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <DockPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        DockPanel.Dock="Top"
                        FontWeight="SemiBold"
                        Text="{lex:Loc Designer.Graph.NodeCatalog}" />
                    <ui:TextBox
                        Margin="0,0,0,8"
                        DockPanel.Dock="Top"
                        Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ScrollViewer
                        MaxHeight="560"
                        scrolling:ModernScroll.Ownership="Self"
                        scrolling:NestedSmoothScrollBehavior.IsEnabled="True"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredCatalog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button
                                        Width="188"
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        PreviewMouseLeftButtonDown="CatalogItem_OnPreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="CatalogItem_OnPreviewMouseLeftButtonUp"
                                        PreviewMouseMove="CatalogItem_OnPreviewMouseMove">
                                        <ui:Button.ToolTip>
                                            <StackPanel MaxWidth="260">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{lex:Loc Designer.Graph.NodeCatalog.DragHint}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ui:Button.ToolTip>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding DisplayName}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Category}" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <Border
                Grid.Column="2"
                Margin="0,0,8,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <ScrollViewer
                        x:Name="GraphScrollViewer"
                        scrolling:ModernScroll.Ownership="Self"
                        scrolling:NestedSmoothScrollBehavior.IsEnabled="True"
                        HorizontalScrollBarVisibility="Auto"
                        MouseLeave="GraphScrollViewer_OnMouseLeave"
                        PreviewMouseDown="GraphScrollViewer_OnPreviewMouseDown"
                        PreviewMouseLeftButtonUp="GraphScrollViewer_OnPreviewMouseLeftButtonUp"
                        PreviewMouseMove="GraphScrollViewer_OnPreviewMouseMove"
                        PreviewMouseRightButtonUp="GraphScrollViewer_OnPreviewMouseRightButtonUp"
                        PreviewMouseWheel="GraphScrollViewer_OnPreviewMouseWheel"
                        ScrollChanged="GraphScrollViewer_OnScrollChanged"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="ZoomContainer">
                            <Canvas
                                x:Name="GraphCanvas"
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                AllowDrop="True"
                                DragOver="GraphCanvas_OnDragOver"
                                Drop="GraphCanvas_OnDrop"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <Canvas.Background>
                                    <DrawingBrush
                                        TileMode="Tile"
                                        Viewport="0,0,24,24"
                                        ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#FF2A2A2A">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,24,24" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#28FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <EllipseGeometry
                                                            Center="12,12"
                                                            RadiusX="1.2"
                                                            RadiusY="1.2" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Canvas.Background>
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <!--  隐形宽路径用于鼠标悬停检测（增大热区）  -->
                                                <Path
                                                    Data="{Binding PathData}"
                                                    MouseEnter="ConnectionPath_OnMouseEnter"
                                                    MouseLeave="ConnectionPath_OnMouseLeave"
                                                    Stroke="Transparent"
                                                    StrokeLineJoin="Round"
                                                    StrokeThickness="14"
                                                    ToolTip="{Binding InspectionText}" />
                                                <!--  可视连线  -->
                                                <Path
                                                    Data="{Binding PathData}"
                                                    IsHitTestVisible="False"
                                                    Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                    StrokeLineJoin="Round"
                                                    StrokeThickness="{Binding StrokeThickness}" />
                                                <ui:Button
                                                    Canvas.Left="{Binding MidX}"
                                                    Canvas.Top="{Binding MidY}"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Command="{Binding DataContext.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×"
                                                    MouseEnter="ConnectionDeleteBtn_OnMouseEnter"
                                                    MouseLeave="ConnectionDeleteBtn_OnMouseLeave"
                                                    ToolTip="{Binding InspectionText}"
                                                    Visibility="Collapsed" />
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Path
                                    x:Name="ConnectionPreviewPath"
                                    Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    StrokeDashArray="3,2"
                                    StrokeThickness="3"
                                    Visibility="Collapsed" />
                                <!--  框选矩形  -->
                                <Rectangle
                                    x:Name="SelectionRect"
                                    Fill="#22000000"
                                    IsHitTestVisible="False"
                                    Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    StrokeDashArray="3,2"
                                    StrokeThickness="1.5"
                                    Visibility="Collapsed" />
                                <ItemsControl ItemsSource="{Binding Nodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                x:Name="NodeBorder"
                                                Width="{Binding CardWidth}"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                MouseRightButtonUp="NodeCard_OnMouseRightButtonUp"
                                                PreviewMouseLeftButtonDown="NodeCard_OnPreviewMouseLeftButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Click="DuplicateNodeMenuItem_OnClick" Header="{lex:Loc Designer.Graph.DuplicateNode}" />
                                                        <MenuItem Click="DeleteNodeMenuItem_OnClick" Header="{lex:Loc Designer.Graph.DeleteNode}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.ToolTip>
                                                    <StackPanel MaxWidth="280">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{lex:Loc Designer.Graph.Node.Shortcuts}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border.ToolTip>
                                                <Grid>
                                                    <!--  选中态左侧强调条  -->
                                                    <Rectangle
                                                        x:Name="SelectionAccent"
                                                        Width="3"
                                                        HorizontalAlignment="Left"
                                                        Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed" />
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="36" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <primitives:Thumb
                                                            DragCompleted="NodeHeader_OnDragCompleted"
                                                            DragDelta="NodeHeader_OnDragDelta"
                                                            DragStarted="NodeHeader_OnDragStarted">
                                                            <primitives:Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                                                    <Border Padding="8,0,8,0" CornerRadius="6,6,0,0">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Offset="0" Color="{DynamicResource SubtleFillColorSecondary}" />
                                                                                <GradientStop Offset="1" Color="{DynamicResource SubtleFillColorTertiary}" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <Grid>
                                                                            <TextBlock
                                                                                VerticalAlignment="Center"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                                Text="{Binding HeaderText}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip="{Binding RawSummary}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </primitives:Thumb.Template>
                                                        </primitives:Thumb>
                                                        <Grid Grid.Row="1" Margin="6,8,6,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>

                                                            <!--  输入端口：彩色圆点  -->
                                                            <ItemsControl ItemsSource="{Binding InputPorts}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border
                                                                            Height="24"
                                                                            Margin="{Binding RowMargin}"
                                                                            Background="Transparent"
                                                                            Cursor="Hand"
                                                                            MouseEnter="Port_OnMouseEnter"
                                                                            MouseLeave="Port_OnMouseLeave"
                                                                            MouseLeftButtonDown="InputPort_OnMouseLeftButtonDown"
                                                                            MouseLeftButtonUp="InputPort_OnMouseLeftButtonUp">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                                            <Setter Property="Opacity" Value="0.3" />
                                                                                            <Setter Property="Cursor" Value="No" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                                            <Setter Property="Background" Value="#18FFFFFF" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <DockPanel LastChildFill="True">
                                                                                <Grid
                                                                                    Width="14"
                                                                                    Height="14"
                                                                                    Margin="0,0,5,0"
                                                                                    VerticalAlignment="Center">
                                                                                    <Ellipse
                                                                                        Width="10"
                                                                                        Height="10"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Center"
                                                                                        Fill="{Binding PortColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                                                </Grid>
                                                                                <TextBlock
                                                                                    VerticalAlignment="Center"
                                                                                    FontSize="11"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                    Text="{Binding DisplayName}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </DockPanel>
                                                                            <Border.ToolTip>
                                                                                <ToolTip>
                                                                                    <StackPanel MaxWidth="240">
                                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                                        <TextBlock
                                                                                            Margin="0,0,0,4"
                                                                                            Text="{Binding TooltipText}"
                                                                                            TextWrapping="Wrap" />
                                                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                                            <Run Text="{lex:Loc Designer.Graph.Tooltip.PortKind}" /><Run Text=": " />
                                                                                            <Run Text="{Binding PortKindName, Mode=OneWay}" />
                                                                                        </TextBlock>
                                                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                                            <Run Text="{lex:Loc Designer.Graph.Tooltip.PortType}" /><Run Text=": " />
                                                                                            <Run Text="{Binding ValueTypeName, Mode=OneWay}" />
                                                                                        </TextBlock>
                                                                                        <TextBlock
                                                                                            Margin="0,4,0,0"
                                                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                                            Text="{Binding Name}" />
                                                                                    </StackPanel>
                                                                                </ToolTip>
                                                                            </Border.ToolTip>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!--  输出端口：彩色圆点  -->
                                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding OutputPorts}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border
                                                                            Height="24"
                                                                            Margin="{Binding RowMargin}"
                                                                            Background="Transparent"
                                                                            Cursor="Hand"
                                                                            MouseEnter="Port_OnMouseEnter"
                                                                            MouseLeave="Port_OnMouseLeave"
                                                                            MouseLeftButtonDown="OutputPort_OnMouseLeftButtonDown">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                                            <Setter Property="Opacity" Value="0.3" />
                                                                                            <Setter Property="Cursor" Value="No" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                                            <Setter Property="Background" Value="#18FFFFFF" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <DockPanel LastChildFill="True">
                                                                                <Grid
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    Margin="5,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    DockPanel.Dock="Right">
                                                                                    <Ellipse
                                                                                        x:Name="OutputCircle"
                                                                                        Width="10"
                                                                                        Height="10"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        Fill="{Binding PortColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                                                        <Ellipse.Style>
                                                                                            <Style TargetType="Ellipse">
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsParallelContinuation}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Ellipse.Style>
                                                                                    </Ellipse>
                                                                                    <Polygon
                                                                                        x:Name="OutputDiamond"
                                                                                        Width="14"
                                                                                        Height="14"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        Fill="{Binding PortColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                                        Points="7,0 14,7 7,14 0,7"
                                                                                        Stretch="Fill">
                                                                                        <Polygon.Style>
                                                                                            <Style TargetType="Polygon">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsParallelContinuation}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Polygon.Style>
                                                                                    </Polygon>
                                                                                </Grid>
                                                                                <TextBlock
                                                                                    VerticalAlignment="Center"
                                                                                    FontSize="11"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                    Text="{Binding DisplayName}"
                                                                                    TextAlignment="Right"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </DockPanel>
                                                                            <Border.ToolTip>
                                                                                <ToolTip>
                                                                                    <StackPanel MaxWidth="240">
                                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                                        <TextBlock
                                                                                            Margin="0,0,0,4"
                                                                                            Text="{Binding TooltipText}"
                                                                                            TextWrapping="Wrap" />
                                                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                                            <Run Text="{lex:Loc Designer.Graph.Tooltip.PortKind}" /><Run Text=": " />
                                                                                            <Run Text="{Binding PortKindName, Mode=OneWay}" />
                                                                                        </TextBlock>
                                                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                                            <Run Text="{lex:Loc Designer.Graph.Tooltip.PortType}" /><Run Text=": " />
                                                                                            <Run Text="{Binding ValueTypeName, Mode=OneWay}" />
                                                                                        </TextBlock>
                                                                                        <TextBlock
                                                                                            Margin="0,4,0,0"
                                                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                                            Text="{Binding Name}" />
                                                                                    </StackPanel>
                                                                                </ToolTip>
                                                                            </Border.ToolTip>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!--  编辑区域缩放控件（左下角）  -->
                    <StackPanel
                        Margin="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="11"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="EditorZoomInBtn"
                            Width="26"
                            Height="26"
                            Padding="0"
                            Click="EditorZoomIn_OnClick"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Shell"
                            ToolTip="{lex:Loc ZoomIn}">
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button>
                        <ui:Button
                            x:Name="EditorZoomOutBtn"
                            Width="26"
                            Height="26"
                            Margin="4,0,0,0"
                            Padding="0"
                            Click="EditorZoomOut_OnClick"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Shell"
                            ToolTip="{lex:Loc ZoomOut}">
                            <ui:SymbolIcon Symbol="Subtract24" />
                        </ui:Button>
                        <ui:Button
                            x:Name="EditorZoomResetBtn"
                            Width="26"
                            Height="26"
                            Margin="4,0,0,0"
                            Padding="0"
                            Click="EditorZoomReset_OnClick"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.AnimationEditor"
                            ToolTip="{lex:Loc Zoom}">
                            <ui:SymbolIcon Symbol="ArrowReset24" />
                        </ui:Button>
                        <ComboBox
                            x:Name="EditorZoomCombo"
                            Height="34"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            ItemStringFormat="{}{0:P0}"
                            SelectedIndex="3"
                            SelectionChanged="EditorZoomCombo_OnSelectionChanged" />
                    </StackPanel>

                    <!--  总览图（迷你地图）  -->
                    <Border
                        Width="180"
                        Height="120"
                        Margin="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Canvas
                            x:Name="Minimap"
                            Width="180"
                            Height="120"
                            Background="Transparent"
                            ClipToBounds="True"
                            Cursor="Hand"
                            MouseLeftButtonDown="Minimap_OnMouseLeftButtonDown"
                            MouseLeftButtonUp="Minimap_OnMouseLeftButtonUp"
                            MouseMove="Minimap_OnMouseMove">
                            <Rectangle
                                Width="180"
                                Height="120"
                                IsHitTestVisible="False"
                                Opacity="0.85">
                                <Rectangle.Fill>
                                    <VisualBrush Stretch="Uniform" Visual="{Binding ElementName=GraphCanvas}" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle
                                x:Name="MinimapViewport"
                                Fill="#33000000"
                                IsHitTestVisible="False"
                                Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                                StrokeThickness="1.5" />
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="3"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <Border
                x:Name="AnimationPropertyPanel"
                Grid.Column="4"
                Padding="8"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <DockPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        DockPanel.Dock="Top"
                        FontWeight="SemiBold"
                        Text="{lex:Loc Designer.Graph.Properties}" />
                    <ScrollViewer
                        MaxHeight="560"
                        scrolling:ModernScroll.Ownership="Self"
                        scrolling:NestedSmoothScrollBehavior.IsEnabled="True"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedNode.Properties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10" ToolTip="{Binding Description}">
                                        <TextBlock
                                            Margin="0,0,0,3"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding HelpText}"
                                            TextWrapping="Wrap" />
                                        <ui:TextBox
                                            PlaceholderText="{Binding Placeholder}"
                                            Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                                            Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayText"
                                            ItemsSource="{Binding ConditionFieldOptions}"
                                            SelectedValue="{Binding ConditionFieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="ValuePath"
                                            ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}"
                                            Visibility="{Binding IsConditionField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding ConditionOperatorOptions}"
                                            SelectedValue="{Binding ConditionOperatorValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Visibility="{Binding IsConditionOperator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:TextBox
                                            PlaceholderText="{Binding Placeholder}"
                                            Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                                            Visibility="{Binding IsTextConditionValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding ConditionValueOptions}"
                                            SelectedValue="{Binding ConditionChoiceValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value">
                                            <ComboBox.Style>
                                                <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBooleanConditionValue}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEnumConditionValue}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <Grid Visibility="{Binding IsNumberBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:NumberBox
                                                AcceptsExpression="False"
                                                LargeChange="10"
                                                MaxDecimalPlaces="{Binding NumberMaxDecimalPlaces}"
                                                Maximum="{Binding NumberMaximum}"
                                                Minimum="{Binding NumberMinimum}"
                                                PlaceholderText="{Binding Placeholder}"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{Binding NumberValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Unit}"
                                                Visibility="{Binding HasUnit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <Grid Visibility="{Binding IsPercentageNumberText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox PlaceholderText="{Binding Placeholder}" Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Unit}"
                                                Visibility="{Binding HasUnit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <colorpicker:PortableColorPicker
                                                Width="44"
                                                Height="22"
                                                HorizontalAlignment="Left"
                                                SelectedColor="{Binding ColorValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DefaultColorPickerStyle}" />
                                            <ui:TextBox
                                                Width="150"
                                                Margin="6,0,0,0"
                                                PlaceholderText="{Binding Placeholder}"
                                                Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            IsEditable="True"
                                            ItemsSource="{Binding DisplayedOptions}"
                                            SelectedValue="{Binding PropertyNameValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Text="{Binding PropertyNameText, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsPropertyName, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding TargetOptions}"
                                            SelectedValue="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Visibility="{Binding IsControlReference, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding VisibilityOptions}"
                                            SelectedValue="{Binding VisibilityValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Visibility="{Binding IsVisibilityValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            IsEditable="True"
                                            ItemsSource="{Binding LocalizedOptions}"
                                            SelectedValue="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Text="{Binding SuggestionText, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding HasTextSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding BooleanOptions}"
                                            SelectedValue="{Binding BooleanTextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding LocalizedOptions}"
                                            SelectedValue="{Binding EnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            Text="{Binding ValidationError}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter
            Grid.Row="2"
            Height="5"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource CardStrokeColorDefaultBrush}" />

        <Grid
            Grid.Row="3"
            MinHeight="0"
            Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" MinWidth="100" />
            </Grid.ColumnDefinitions>
            <!--  动画预览视口  -->
            <Border
                x:Name="PreviewBorder"
                Margin="0,0,4,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="6"
                MouseDown="PreviewContent_OnMouseDown"
                MouseLeave="PreviewContent_OnMouseLeave"
                PreviewMouseLeftButtonUp="PreviewContent_OnPreviewMouseLeftButtonUp"
                PreviewMouseMove="PreviewContent_OnPreviewMouseMove"
                PreviewMouseRightButtonUp="PreviewContent_OnPreviewMouseRightButtonUp"
                PreviewMouseWheel="PreviewContent_OnPreviewMouseWheel">
                <Grid Background="Transparent">
                    <TextBlock
                        x:Name="PreviewTitle"
                        Margin="8,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontWeight="SemiBold"
                        IsHitTestVisible="False"
                        Text="{lex:Loc Designer.Graph.PreviewTitle}" />
                    <Grid x:Name="PreviewContentHost">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PreviewScaleTransform" />
                                <TranslateTransform x:Name="PreviewTranslateTransform" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Rectangle x:Name="PreviewViewport" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <VisualBrush x:Name="PreviewVisualBrush" Stretch="Uniform" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <TextBlock
                        x:Name="PreviewPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{lex:Loc Designer.Graph.PreviewPlaceholder}"
                        TextWrapping="Wrap" />

                    <!--  预览区域缩放控件（左下角）  -->
                    <StackPanel
                        Margin="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="True"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="PreviewZoomInBtn"
                            Width="26"
                            Height="26"
                            Padding="0"
                            Click="PreviewZoomIn_OnClick"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Shell"
                            ToolTip="{lex:Loc ZoomIn}">
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button>
                        <ui:Button
                            x:Name="PreviewZoomOutBtn"
                            Width="26"
                            Height="26"
                            Margin="4,0,0,0"
                            Padding="0"
                            Click="PreviewZoomOut_OnClick"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Shell"
                            ToolTip="{lex:Loc ZoomOut}">
                            <ui:SymbolIcon Symbol="Subtract24" />
                        </ui:Button>
                        <ui:Button
                            x:Name="PreviewZoomResetBtn"
                            Width="26"
                            Height="26"
                            Margin="4,0,0,0"
                            Padding="0"
                            Click="PreviewZoomReset_OnClick"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.AnimationEditor"
                            ToolTip="{lex:Loc Zoom}">
                            <ui:SymbolIcon Symbol="ArrowReset24" />
                        </ui:Button>
                        <ComboBox
                            x:Name="PreviewZoomCombo"
                            Height="34"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            ItemStringFormat="{}{0:P0}"
                            SelectedIndex="3"
                            SelectionChanged="PreviewZoomCombo_OnSelectionChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <!--  执行日志  -->
            <Border
                Grid.Column="2"
                Margin="4,0,0,0"
                Padding="6"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="{lex:Loc Designer.Graph.ExecutionLog}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Command="{Binding ClearExecutionLogCommand}"
                            Content="{lex:Loc Designer.Graph.ClearLog}" />
                    </StackPanel>
                    <ScrollViewer
                        scrolling:ModernScroll.Ownership="Self"
                        scrolling:NestedSmoothScrollBehavior.IsEnabled="True"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExecutionLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
