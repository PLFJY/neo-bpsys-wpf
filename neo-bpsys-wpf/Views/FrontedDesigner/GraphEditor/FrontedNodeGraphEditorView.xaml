<UserControl
    x:Class="neo_bpsys_wpf.Views.FrontedDesigner.GraphEditor.FrontedNodeGraphEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="Locales.Lang"
    Focusable="True"
    PreviewKeyDown="FrontedNodeGraphEditorView_OnPreviewKeyDown"
    scrolling:ModernScroll.Ownership="Self">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="168" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <ui:Button Command="{Binding DeleteSelectedNodeCommand}" Content="{lex:Loc Designer.Graph.DeleteNode}" />
            <ui:Button Margin="6,0,0,0" Command="{Binding DuplicateSelectedNodeCommand}" Content="{lex:Loc Designer.Graph.DuplicateNode}" />
            <ui:Button Margin="6,0,0,0" Command="{Binding AutoCreateStartEndCommand}" Content="{lex:Loc Designer.Graph.AddStartEnd}" />
            <ui:Button Margin="18,0,0,0" Command="{Binding RunGraphPreviewCommand}" Content="{lex:Loc Designer.Graph.RunPreview}" />
            <ui:Button Margin="6,0,0,0" Command="{Binding StopPreviewCommand}" Content="{lex:Loc Designer.Graph.StopPreview}" />
            <ui:Button Margin="6,0,0,0" Command="{Binding ValidateGraphCommand}" Content="{lex:Loc Designer.Graph.Validate}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Text="{Binding ConnectionStatus}" />
        </StackPanel>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,8,0" Padding="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="SemiBold" Text="{lex:Loc Designer.Graph.NodeCatalog}" />
                    <ui:TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ScrollViewer
                        MaxHeight="560"
                        VerticalScrollBarVisibility="Auto"
                        scrolling:ModernScroll.Ownership="Self"
                        scrolling:NestedSmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding FilteredCatalog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button
                                        Width="188"
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        PreviewMouseLeftButtonDown="CatalogItem_OnPreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="CatalogItem_OnPreviewMouseLeftButtonUp"
                                        PreviewMouseMove="CatalogItem_OnPreviewMouseMove">
                                        <ui:Button.ToolTip>
                                            <StackPanel MaxWidth="260">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{lex:Loc Designer.Graph.NodeCatalog.DragHint}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ui:Button.ToolTip>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DisplayName}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Category}" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="0,0,8,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer
                    x:Name="GraphScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    PreviewMouseDown="GraphScrollViewer_OnPreviewMouseDown"
                    PreviewMouseMove="GraphScrollViewer_OnPreviewMouseMove"
                    PreviewMouseLeftButtonUp="GraphScrollViewer_OnPreviewMouseLeftButtonUp"
                    PreviewMouseRightButtonUp="GraphScrollViewer_OnPreviewMouseRightButtonUp"
                    MouseLeave="GraphScrollViewer_OnMouseLeave"
                    scrolling:ModernScroll.Ownership="Self"
                    scrolling:NestedSmoothScrollBehavior.IsEnabled="True">
                    <Canvas
                        x:Name="GraphCanvas"
                        Width="{Binding CanvasWidth}"
                        Height="{Binding CanvasHeight}"
                        AllowDrop="True"
                        DragOver="GraphCanvas_OnDragOver"
                        Drop="GraphCanvas_OnDrop"
                        Background="Transparent">
                        <ItemsControl ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas
                                        Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{DynamicResource SystemAccentColorPrimaryBrush}" StrokeThickness="2" />
                                        <ui:Button
                                            Canvas.Left="{Binding MidX}"
                                            Canvas.Top="{Binding MidY}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Command="{Binding DataContext.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="×"
                                            ToolTip="{lex:Loc Designer.Graph.DeleteConnection}" />
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Line
                            x:Name="ConnectionPreviewLine"
                            Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                            StrokeDashArray="3,2"
                            StrokeThickness="2"
                            Visibility="Collapsed" />
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="190"
                                        Padding="0,0,0,8"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        PreviewMouseLeftButtonDown="NodeCard_OnPreviewMouseLeftButtonDown"
                                        MouseRightButtonUp="NodeCard_OnMouseRightButtonUp">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Click="DeleteNodeMenuItem_OnClick"
                                                    Header="{lex:Loc Designer.Graph.DeleteNode}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.ToolTip>
                                            <StackPanel MaxWidth="280">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{lex:Loc Designer.Graph.Node.Shortcuts}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <primitives:Thumb DragDelta="NodeHeader_OnDragDelta">
                                                <primitives:Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                                        <Border Padding="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6,6,0,0">
                                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DisplayName}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </primitives:Thumb.Template>
                                            </primitives:Thumb>
                                            <Grid Grid.Row="1" Margin="6,8,6,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <ItemsControl ItemsSource="{Binding InputPorts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="0,1,2,1"
                                                                Padding="4,2"
                                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="4"
                                                                MouseLeftButtonUp="InputPort_OnMouseLeftButtonUp"
                                                                ToolTip="{Binding Name}">
                                                                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding OutputPorts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="2,1,0,1"
                                                                Padding="4,2"
                                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="4"
                                                                MouseLeftButtonDown="OutputPort_OnMouseLeftButtonDown"
                                                                ToolTip="{Binding Name}">
                                                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Padding="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold" Text="{lex:Loc Designer.Graph.Properties}" />
                    <ScrollViewer
                        MaxHeight="560"
                        VerticalScrollBarVisibility="Auto"
                        scrolling:ModernScroll.Ownership="Self"
                        scrolling:NestedSmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding SelectedNode.Properties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10" ToolTip="{Binding Description}">
                                        <TextBlock Margin="0,0,0,3" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                        <ui:TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <CheckBox Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsChecked="{Binding BooleanValue}" Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EnumValue}" Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0" MinHeight="0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Margin="0,0,4,0" Padding="6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{lex:Loc Designer.Graph.Validation}" ToolTip="{lex:Loc Designer.Graph.Validation.Description}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" scrolling:ModernScroll.Ownership="Self" scrolling:NestedSmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding ValidationMessages}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Margin="4,0,0,0" Padding="6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Command="{Binding ClearExecutionLogCommand}" Content="{lex:Loc Designer.Graph.ClearLog}" />
                        <ui:Button
                            Margin="6,0,0,0"
                            Padding="12,4"
                            Click="OpenHelp_OnClick"
                            Content="{lex:Loc Designer.Graph.Help}"
                            Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" scrolling:ModernScroll.Ownership="Self" scrolling:NestedSmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding ExecutionLog}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
