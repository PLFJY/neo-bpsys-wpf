<UserControl
    x:Class="neo_bpsys_wpf.Views.FrontedDesigner.BehaviorPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.FrontedDesigner"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="Locales.Lang">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="TriggerEditorTemplate" DataType="{x:Type vm:TriggerDescriptorEditorViewModel}">
            <StackPanel>
                <ComboBox
                    Margin="0,0,0,8"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding EventOptions}"
                    SelectedValue="{Binding EventType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="EventType"
                    ToolTip="{Binding SelectedEventDescriptor.Description}" />

                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TriggerFilterEditorViewModel}">
                            <Border
                                Margin="0,0,0,6"
                                Padding="8"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Text="{lex:Loc Designer.Behaviors.When}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        MinWidth="120"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding PayloadFieldOptions}"
                                        SelectedValue="{Binding Left, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Path">
                                        <ComboBox.ToolTip>
                                            <TextBlock Text="{Binding Left}" />
                                        </ComboBox.ToolTip>
                                    </ComboBox>
                                    <ComboBox
                                        Grid.Column="2"
                                        MinWidth="58"
                                        Margin="6,0"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding DisplayedOperatorOptions}"
                                        SelectedValue="{Binding Operator, Mode=TwoWay}"
                                        SelectedValuePath="Value" />
                                    <ui:TextBox
                                        Grid.Column="3"
                                        MinWidth="80"
                                        PlaceholderText="{lex:Loc Designer.Behaviors.Value}"
                                        Text="{Binding Right, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}">
                                        <ui:TextBox.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTextValue}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBox.Style>
                                    </ui:TextBox>
                                    <ComboBox
                                        Grid.Column="3"
                                        MinWidth="100"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding EnumValueOptions}"
                                        SelectedValue="{Binding Right, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Value">
                                        <ComboBox.Style>
                                            <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnumField}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <ui:Button
                                        Grid.Column="4"
                                        MinWidth="30"
                                        Margin="6,0,0,0"
                                        Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="-" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="3"
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Opacity="0.72"
                                        Text="{Binding HintText}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHintText}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding AddFilterCommand}"
                    Content="{lex:Loc Designer.Behaviors.AddFilter}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border
            Padding="8"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{lex:Loc Designer.Behaviors.SelectedControl}" />
                <TextBlock
                    Margin="0,3,0,0"
                    Opacity="0.78"
                    Text="{Binding SelectedControl.Name, TargetNullValue='-'}" />
            </StackPanel>
        </Border>

        <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
            <ui:Button
                Margin="0,0,4,4"
                Command="{Binding AddOneShotBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.AddOneShot}" />
            <ui:Button
                Margin="0,0,4,4"
                Command="{Binding AddLoopBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.AddLoop}" />
            <ui:Button
                Margin="0,0,4,4"
                Command="{Binding AddTransitionBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.AddTransition}" />
            <ui:Button
                Margin="0,0,4,4"
                Command="{Binding PasteBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.Paste}" />
        </WrapPanel>
        <TextBlock
            Margin="0,6,0,0"
            Opacity="0.72"
            Text="{Binding PasteStatus}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,6"
            FontWeight="SemiBold"
            Text="{lex:Loc Designer.Behaviors.List}" />
        <TextBlock
            Margin="0,0,0,8"
            Opacity="0.72"
            Text="{Binding EmptyText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBehaviors}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Behaviors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BehaviorEditorViewModel}">
                    <Expander
                        Margin="0,0,0,8"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Expander.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.CopyBehaviorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{lex:Loc Designer.Behaviors.Copy}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.CopyBehaviorToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{lex:Loc Designer.Behaviors.CopyTo}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.DuplicateBehaviorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{lex:Loc Designer.Behaviors.Duplicate}" />
                                <Separator />
                                <MenuItem Command="{Binding PlacementTarget.Tag.PasteBehaviorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="{lex:Loc Designer.Behaviors.Paste}" />
                                <MenuItem
                                    Command="{Binding PlacementTarget.Tag.DeleteBehaviorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}"
                                    Header="{lex:Loc Designer.Behaviors.Delete}" />
                            </ContextMenu>
                        </Expander.ContextMenu>
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Margin="6,0,8,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.72"
                                        Text="{Binding TriggerSummary}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="6,0,6,0"
                                    Click="BehaviorMoreButton_OnClick"
                                    Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="{lex:Loc Designer.Behaviors.MoreOptions}">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.CopyBehaviorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding}"
                                                Header="{lex:Loc Designer.Behaviors.Copy}" />
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.CopyBehaviorToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding}"
                                                Header="{lex:Loc Designer.Behaviors.CopyTo}" />
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DuplicateBehaviorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding}"
                                                Header="{lex:Loc Designer.Behaviors.Duplicate}" />
                                            <Separator />
                                            <MenuItem
                                                Command="{Binding PlacementTarget.Tag.DeleteBehaviorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding}"
                                                Header="{lex:Loc Designer.Behaviors.Delete}" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Margin="10">
                            <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOneShot}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.Trigger}" />
                                <ContentControl Content="{Binding Trigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoop}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.StartTrigger}" />
                                <ContentControl Content="{Binding StartTrigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.StopTriggers}" />
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Opacity="0.72"
                                    Text="{lex:Loc Designer.Behaviors.StopTriggersHelp}"
                                    TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding StopTriggers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TriggerDescriptorEditorViewModel}">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="8"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Text="{lex:Loc Designer.Behaviors.StopTrigger}" />
                                                        <StackPanel
                                                            HorizontalAlignment="Right"
                                                            DockPanel.Dock="Right"
                                                            Orientation="Horizontal">
                                                            <ui:Button
                                                                MinWidth="30"
                                                                Command="{Binding DataContext.DuplicateStopTriggerCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=Copy24}" />
                                                            <ui:Button
                                                                MinWidth="30"
                                                                Margin="6,0,0,0"
                                                                Command="{Binding DataContext.RemoveStopTriggerCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                CommandParameter="{Binding}"
                                                                Icon="{ui:SymbolIcon Symbol=Delete24}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddStopTriggerCommand}"
                                    Content="{lex:Loc Designer.Behaviors.AddStopTrigger}" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransition}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.TransitionTrigger}" />
                                <ContentControl Content="{Binding TransitionTrigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.ReentryPolicy}" />
                                <ComboBox
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding ReentryPolicyOptions}"
                                    SelectedValue="{Binding ReentryPolicy, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Opacity="0.72"
                                    Text="{lex:Loc Designer.Behaviors.TransitionHelp}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,10,0,6"
                                Opacity="0.72"
                                Text="{Binding GraphSummary}"
                                TextWrapping="Wrap" />
                            <ui:Button Command="{Binding OpenAnimationEditorCommand}" Content="{lex:Loc Designer.Behaviors.OpenAnimationEditor}" />
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
