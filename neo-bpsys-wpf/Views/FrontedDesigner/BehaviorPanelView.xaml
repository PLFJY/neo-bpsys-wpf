<UserControl
    x:Class="neo_bpsys_wpf.Views.FrontedDesigner.BehaviorPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.FrontedDesigner"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="Locales.Lang">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="TriggerEditorTemplate" DataType="{x:Type vm:TriggerDescriptorEditorViewModel}">
            <StackPanel>
                <ComboBox
                    Margin="0,0,0,8"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding EventOptions}"
                    SelectedValue="{Binding EventType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="EventType"
                    ToolTip="{Binding SelectedEventDescriptor.Description}" />

                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TriggerFilterEditorViewModel}">
                            <Border
                                Margin="0,0,0,6"
                                Padding="8"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Text="{lex:Loc Designer.Behaviors.When}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        MinWidth="120"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding PayloadFieldOptions}"
                                        SelectedValue="{Binding Left, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Path">
                                        <ComboBox.ToolTip>
                                            <TextBlock Text="{Binding Left}" />
                                        </ComboBox.ToolTip>
                                    </ComboBox>
                                    <ComboBox
                                        Grid.Column="2"
                                        MinWidth="58"
                                        Margin="6,0"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding OperatorOptions}"
                                        SelectedValue="{Binding Operator, Mode=TwoWay}"
                                        SelectedValuePath="Value" />
                                    <ui:TextBox
                                        Grid.Column="3"
                                        MinWidth="80"
                                        PlaceholderText="{lex:Loc Designer.Behaviors.Value}"
                                        Text="{Binding Right, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <ui:Button
                                        Grid.Column="4"
                                        MinWidth="30"
                                        Margin="6,0,0,0"
                                        Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="-" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding AddFilterCommand}"
                    Content="{lex:Loc Designer.Behaviors.AddFilter}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border
            Padding="8"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{lex:Loc Designer.Behaviors.SelectedControl}" />
                <TextBlock
                    Margin="0,3,0,0"
                    Opacity="0.78"
                    Text="{Binding SelectedControl.Name, TargetNullValue='-'}" />
            </StackPanel>
        </Border>

        <Expander
            Margin="0,10,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Header="{lex:Loc Designer.Behaviors.BehaviorTags}">
            <StackPanel Margin="8" DataContext="{Binding TagsEditor}">
                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BehaviorTagRowViewModel}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    MinWidth="80"
                                    Margin="0,0,4,0"
                                    PlaceholderText="Camp"
                                    Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <ui:TextBox
                                    Grid.Column="1"
                                    MinWidth="80"
                                    Margin="4,0,4,0"
                                    PlaceholderText="Sur"
                                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                                <ui:Button
                                    Grid.Column="2"
                                    MinWidth="30"
                                    Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="-" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,0,0,6"
                    Opacity="0.72"
                    Text="Camp = Sur, PlayerIndex = 0, Role = PickSlot"
                    TextWrapping="Wrap" />
                <ui:Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding AddTagCommand}"
                    Content="{lex:Loc Designer.Behaviors.AddBehaviorTag}" />
            </StackPanel>
        </Expander>

        <UniformGrid Margin="0,10,0,0" Columns="2">
            <ui:Button
                Margin="0,0,4,0"
                Command="{Binding AddOneShotBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.AddOneShot}" />
            <ui:Button
                Margin="4,0,0,0"
                Command="{Binding AddLoopBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.AddLoop}" />
        </UniformGrid>

        <TextBlock
            Margin="0,12,0,6"
            FontWeight="SemiBold"
            Text="{lex:Loc Designer.Behaviors.List}" />
        <TextBlock
            Margin="0,0,0,8"
            Opacity="0.72"
            Text="{Binding EmptyText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBehaviors}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Behaviors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BehaviorEditorViewModel}">
                    <Expander
                        Margin="0,0,0,8"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Margin="6,0,8,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.72"
                                        Text="{Binding TriggerSummary}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Command="{Binding TestTriggerCommand}"
                                    Content="{lex:Loc Designer.Behaviors.TestTrigger}" />
                                <ui:Button
                                    Grid.Column="3"
                                    Margin="6,0,0,0"
                                    Command="{Binding DataContext.DuplicateBehaviorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{lex:Loc Designer.Behaviors.Duplicate}" />
                                <ui:Button
                                    Grid.Column="4"
                                    Margin="6,0,6,0"
                                    Command="{Binding DataContext.DeleteBehaviorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{lex:Loc Designer.Behaviors.Delete}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Margin="10">
                            <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOneShot}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.Trigger}" />
                                <ContentControl Content="{Binding Trigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoop}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.StartTrigger}" />
                                <ContentControl Content="{Binding StartTrigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{lex:Loc Designer.Behaviors.EndTrigger}" />
                                <ContentControl Content="{Binding EndTrigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,10,0,6"
                                Opacity="0.72"
                                Text="{Binding GraphSummary}"
                                TextWrapping="Wrap" />
                            <ui:Button Command="{Binding OpenAnimationEditorCommand}" Content="{lex:Loc Designer.Behaviors.OpenAnimationEditor}" />
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
