<UserControl
    x:Class="neo_bpsys_wpf.Views.FrontedDesigner.BehaviorPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.FrontedDesigner"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="Locales.Lang">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <DataTemplate x:Key="TriggerEditorTemplate" DataType="{x:Type vm:TriggerDescriptorEditorViewModel}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.EventType}" />
                    <ComboBox
                        Grid.Column="1"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding EventOptions}"
                        SelectedValue="{Binding EventType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Value" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Source}" />
                    <ui:TextBox
                        Grid.Column="1"
                        MinHeight="30"
                        Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                </Grid>

                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Filters}" />
                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TriggerFilterEditorViewModel}">
                            <Border
                                Margin="0,0,0,8"
                                Padding="8"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Left}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            MinHeight="30"
                                            Text="{Binding Left, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Operator}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding OperatorOptions}"
                                            SelectedValue="{Binding Operator, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Right}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            MinHeight="30"
                                            Text="{Binding Right, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.RightValueKind}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding RightValueKindOptions}"
                                            SelectedValue="{Binding RightValueKind, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                        <ui:Button
                                            Grid.Column="2"
                                            MinWidth="30"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="-" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding AddFilterCommand}"
                    Content="{lex:Loc Designer.Behaviors.AddFilter}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border
            Padding="8"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{lex:Loc Designer.Behaviors.SelectedControl}" />
                <TextBlock
                    Margin="0,3,0,0"
                    Opacity="0.78"
                    Text="{Binding SelectedControl.Name, TargetNullValue='-'}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <UniformGrid Margin="0,10,0,0" Columns="2">
            <ui:Button
                Margin="0,0,4,0"
                Command="{Binding AddOneShotBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.AddOneShot}" />
            <ui:Button
                Margin="4,0,0,0"
                Command="{Binding AddLoopBehaviorCommand}"
                Content="{lex:Loc Designer.Behaviors.AddLoop}" />
        </UniformGrid>

        <TextBlock
            Margin="0,14,0,6"
            FontWeight="SemiBold"
            Text="{lex:Loc Designer.Behaviors.List}" />

        <TextBlock
            Margin="0,0,0,8"
            Opacity="0.72"
            Text="{Binding EmptyText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBehaviors}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListBox
            MaxHeight="220"
            ItemsSource="{Binding Behaviors}"
            SelectedItem="{Binding SelectedBehavior, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BehaviorEditorViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Enabled, Mode=TwoWay}"
                            ToolTip="{lex:Loc Designer.Behaviors.Enabled}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Opacity="0.72">
                                <Run Text="{Binding KindDisplay, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding TriggerSummary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <ui:Button
                            Grid.Column="2"
                            MinWidth="30"
                            Margin="8,0,0,0"
                            Command="{Binding DataContext.DuplicateBehaviorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{lex:Loc Designer.Behaviors.Duplicate}" />
                        <ui:Button
                            Grid.Column="3"
                            MinWidth="30"
                            Margin="6,0,0,0"
                            Command="{Binding DataContext.DeleteBehaviorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{lex:Loc Designer.Behaviors.Delete}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock
            Margin="0,12,0,0"
            Opacity="0.72"
            Text="{lex:Loc Designer.Behaviors.SelectBehaviorToEdit}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasBehaviors}" Value="True" />
                                <Condition Binding="{Binding HasSelectedBehavior}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border
            Margin="0,12,0,0"
            Padding="10"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedBehavior}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <ContentControl Content="{Binding SelectedBehavior}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:BehaviorEditorViewModel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Details}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Name}" />
                                <ui:TextBox
                                    Grid.Column="1"
                                    MinHeight="30"
                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Kind}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{Binding KindDisplay, Mode=OneWay}" />
                            </Grid>
                            <CheckBox
                                Margin="0,0,0,12"
                                Content="{lex:Loc Designer.Behaviors.Enabled}"
                                IsChecked="{Binding Enabled, Mode=TwoWay}" />

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOneShot}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.Trigger}" />
                                <ContentControl Content="{Binding Trigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoop}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.StartTrigger}" />
                                <ContentControl Content="{Binding StartTrigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />

                                <TextBlock
                                    Margin="0,12,0,8"
                                    FontWeight="SemiBold"
                                    Text="{lex:Loc Designer.Behaviors.EndTrigger}" />
                                <ContentControl Content="{Binding EndTrigger}" ContentTemplate="{StaticResource TriggerEditorTemplate}" />

                                <TextBlock
                                    Margin="0,12,0,8"
                                    FontWeight="SemiBold"
                                    Text="{lex:Loc Designer.Behaviors.LoopPolicy}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelTextBlockStyle}" Text="{lex:Loc Designer.Behaviors.RepeatCount}" />
                                    <ui:TextBox Grid.Row="0" Grid.Column="1" MinHeight="30" Text="{Binding LoopPolicy.RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Content="{lex:Loc Designer.Behaviors.AutoReverse}" IsChecked="{Binding LoopPolicy.AutoReverse, Mode=TwoWay}" />
                                    <TextBlock Grid.Row="2" Margin="0,8,8,0" VerticalAlignment="Center" Opacity="0.82" Text="{lex:Loc Designer.Behaviors.IntervalMs}" />
                                    <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" MinHeight="30" Text="{Binding LoopPolicy.IntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Margin="0,8,8,0" VerticalAlignment="Center" Opacity="0.82" Text="{lex:Loc Designer.Behaviors.StopMode}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding LoopPolicy.StopModeOptions}" SelectedValue="{Binding LoopPolicy.StopMode, Mode=TwoWay}" SelectedValuePath="Value" />
                                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0" Content="{lex:Loc Designer.Behaviors.ResetOnStop}" IsChecked="{Binding LoopPolicy.ResetOnStop, Mode=TwoWay}" />
                                    <TextBlock Grid.Row="5" Margin="0,8,8,0" VerticalAlignment="Center" Opacity="0.82" Text="{lex:Loc Designer.Behaviors.ReentryPolicy}" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" DisplayMemberPath="DisplayName" ItemsSource="{Binding LoopPolicy.ReentryPolicyOptions}" SelectedValue="{Binding LoopPolicy.ReentryPolicy, Mode=TwoWay}" SelectedValuePath="Value" />
                                </Grid>

                                <TextBlock
                                    Margin="0,12,0,8"
                                    FontWeight="SemiBold"
                                    Text="{lex:Loc Designer.Behaviors.GraphPlaceholders}" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{lex:Loc Designer.Behaviors.StartGraph}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding GraphPlaceholder, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{lex:Loc Designer.Behaviors.LoopGraph}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding GraphPlaceholder, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{lex:Loc Designer.Behaviors.StopGraph}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding GraphPlaceholder, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </StackPanel>
</UserControl>
