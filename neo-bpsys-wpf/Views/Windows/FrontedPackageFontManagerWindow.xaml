<ui:FluentWindow
    x:Class="neo_bpsys_wpf.Views.Windows.FrontedPackageFontManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:neo_bpsys_wpf.Controls"
    xmlns:designer="clr-namespace:neo_bpsys_wpf.Core.Models.FrontedLayout.Designer;assembly=neo-bpsys-wpf.Core"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{lex:Loc Designer.Editor.ManagePackageFonts}"
    Width="720"
    Height="520"
    MinWidth="560"
    MinHeight="380"
    lex:LocalizeDictionary.DesignCulture="zh"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="Locales.Designer"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="FrontedPackageFontManagerWindow_OnLoaded"
    WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="35"
            CornerRadius="8"
            GlassFrameThickness="0"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:CustomTitleBar
            Grid.Row="0"
            Icon="/Assets/icon.png"
            IsMaximizeVisible="True"
            IsMinimizeVisible="True"
            IsThemeChangeVisible="False"
            IsTopMostVisible="False" />
        <Grid Grid.Row="1" Margin="12">
            <ui:ListView ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont, Mode=TwoWay}">
                <ui:ListView.View>
                    <ui:GridView>
                        <GridViewColumn Width="260" Header="{lex:Loc Designer.Editor.PackageFontFamilies}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type designer:FrontedPackageFontItem}">
                                    <TextBlock Text="{Binding FontFamilyDisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn
                            Width="240"
                            DisplayMemberBinding="{Binding FileName}"
                            Header="{lex:Loc Designer.Editor.PackageFontFile}" />
                        <GridViewColumn Width="140" Header="{lex:Loc Designer.Editor.PackageFontStatus}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type designer:FrontedPackageFontItem}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{lex:Loc Designer.Editor.PackageFontAvailable}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReferenced}" Value="True">
                                                        <Setter Property="Text" Value="{lex:Loc Designer.Editor.PackageFontInUse}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.65"
                Text="{lex:Loc Designer.Editor.PackageFontsEmpty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoFonts}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <TextBlock
            Grid.Row="2"
            Margin="12,0,12,8"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StatusText}"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="3"
            Margin="12,0,12,12"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="96"
                Click="DeleteSelectedFont_OnClick"
                Content="{lex:Loc Designer.Editor.PackageFontDelete}"
                Icon="{ui:SymbolIcon Symbol=Delete24}"
                IsEnabled="{Binding CanDeleteSelectedFont}" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Click="Close_OnClick"
                Content="{lex:Loc Close}"
                lex:ResxLocalizationProvider.DefaultDictionary="Locales.Common" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
