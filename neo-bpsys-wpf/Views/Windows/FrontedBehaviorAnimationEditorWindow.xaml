<ui:FluentWindow
    x:Class="neo_bpsys_wpf.Views.Windows.FrontedBehaviorAnimationEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:neo_bpsys_wpf.Controls"
    xmlns:modernNavigation="clr-namespace:neo_bpsys_wpf.Controls.Modern.Navigation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="1280"
    Height="760"
    MinWidth="900"
    MinHeight="600"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:CustomTitleBar Icon="/Assets/icon.png" IsThemeChangeVisible="False" IsTopMostVisible="False" />
        <modernNavigation:ModernNavigationView
            x:Name="AnimationTabs"
            Grid.Row="1"
            AlwaysShowHeader="False"
            FrameMargin="12"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            NavigationBehavior="LocalTabs"
            PaneDisplayMode="Top"
            TransitionDuration="160" />
    </Grid>
</ui:FluentWindow>
