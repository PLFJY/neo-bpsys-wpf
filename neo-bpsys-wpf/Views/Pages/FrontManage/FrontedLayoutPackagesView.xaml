<UserControl
    x:Class="neo_bpsys_wpf.Views.Pages.FrontManage.FrontedLayoutPackagesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:FrontManagePageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="900"
    d:DesignWidth="685"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.FrontManage"
    scrolling:ModernScroll.Ownership="Self"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,10,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="340" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ActiveLayoutPackagePanel">
                <TextBlock
                    FontSize="18"
                    FontWeight="DemiBold"
                    Text="{lex:Loc LayoutPackageManager}" />
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{lex:Loc ActivePackage}" />
                    <Run Text=": " />
                    <Run Text="{Binding ActivePackageDisplay}" />
                </TextBlock>
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding PackageManagerStatus}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <ui:Button
                    x:Name="ImportLayoutPackageButton"
                    Margin="0,0,8,8"
                    Command="{Binding ImportPackageCommand}"
                    Content="{lex:Loc ImportPackage}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding ExportPackageCommand}"
                    Content="{lex:Loc ExportPackage}" />
                <ui:Button
                    Margin="0,0,0,8"
                    Command="{Binding RefreshPackagesCommand}"
                    Content="{lex:Loc RefreshPackages}" />
            </WrapPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="10"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{lex:Loc CompactPackageList}" />
                <ListBox
                    x:Name="LayoutPackageList"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    scrolling:ModernScroll.Ownership="Self"
                    scrolling:NestedSmoothScrollBehavior.IsEnabled="True"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding LayoutPackages}"
                    MouseDoubleClick="PackageListBox_OnMouseDoubleClick"
                    RequestBringIntoView="PackageListBox_OnRequestBringIntoView"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="ItemBorder"
                                            Padding="10,8"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding PackageId}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <WrapPanel
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right">
                                    <Border
                                        Padding="7,2"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock FontSize="11" Text="{Binding Source}" />
                                    </Border>
                                    <Border
                                        Margin="6,0,0,0"
                                        Padding="7,2"
                                        Background="{DynamicResource SystemFillColorSuccessBrush}"
                                        CornerRadius="4"
                                        Visibility="{Binding IsActivePackage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="11" Text="{lex:Loc ActivePackage}" />
                                    </Border>
                                </WrapPanel>
                                <WrapPanel
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0">
                                    <Border
                                        Padding="7,2"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock FontSize="11" Text="{Binding ValidationStatus}" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,1,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis" />
                                </WrapPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,0,0,0"
            Padding="12"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid MinHeight="0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedPackage.Name}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding SelectedPackage.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                    <ui:Button
                        x:Name="ActivateLayoutPackageButton"
                        Margin="0,0,8,8"
                        Command="{Binding ActivatePackageCommand}"
                        Content="{lex:Loc ActivatePackage}" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Command="{Binding DuplicatePackageCommand}"
                        Content="{lex:Loc DuplicateLayoutPackage}" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Command="{Binding OpenPackageFolderCommand}"
                        Content="{lex:Loc OpenPackageFolder}" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Command="{Binding DeletePackageCommand}"
                        Content="{lex:Loc DeletePackage}"
                        Icon="{ui:SymbolIcon Symbol=Delete24}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPackage.IsBuiltin}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </WrapPanel>
                <ui:DynamicScrollViewer
                    Grid.Row="2"
                    scrolling:ModernScroll.Ownership="Self"
                    scrolling:NestedSmoothScrollBehavior.IsEnabled="True"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{lex:Loc PackageBasicInfo}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedPackage.PackageId}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedPackage.Author}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedPackage.MinVersion}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{lex:Loc PackageContents}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="{lex:Loc LayoutCount}" />
                                    <TextBlock Text=": " />
                                    <TextBlock Margin="0,0,14,0" Text="{Binding SelectedPackage.LayoutCount}" />
                                    <TextBlock Text="{lex:Loc ResourceCount}" />
                                    <TextBlock Text=": " />
                                    <TextBlock Text="{Binding SelectedPackage.ResourceCount}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{lex:Loc PackageLocation}" />
                                <ui:TextBox
                                    Margin="0,8,0,0"
                                    IsReadOnly="True"
                                    Text="{Binding SelectedPackage.InstallPath}"
                                    ToolTip="{Binding SelectedPackage.InstallPath}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{lex:Loc PackageValidation}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border
                                        Padding="7,2"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock FontSize="11" Text="{Binding SelectedPackage.ValidationStatus}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedPackage.ValidationMessage}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:DynamicScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
