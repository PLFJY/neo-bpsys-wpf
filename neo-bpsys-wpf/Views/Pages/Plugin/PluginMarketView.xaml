<UserControl x:Class="neo_bpsys_wpf.Views.Pages.Plugin.PluginMarketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:frame="clr-namespace:neo_bpsys_wpf.Controls.Modern.Frame"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.PluginMarket"
    scrolling:ModernScroll.Ownership="Self"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="8,12,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16" LastChildFill="True">
            <ui:Button x:Name="BackButton" DockPanel.Dock="Left" Margin="0,0,12,0"
                Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft24}"
                ToolTip="{lex:Loc MarketBackToBrowse}" AutomationProperties.Name="{lex:Loc MarketBackToBrowse}"
                Command="{Binding ClosePluginMarketOverlaysCommand}"
                Visibility="{Binding HasPluginMarketOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock x:Name="BackLabel" Text="{lex:Loc MarketBackToBrowse}" />
            </ui:Button>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Grid Margin="0,0,8,0">
                    <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="{lex:Loc PluginMarketDownloadQueue}"
                        AutomationProperties.Name="{lex:Loc PluginMarketDownloadQueue}" Command="{Binding ToggleDownloadQueueCommand}">
                        <TextBlock x:Name="DownloadsLabel" Text="{lex:Loc PluginMarketDownloadQueue}" />
                    </ui:Button>
                    <ui:InfoBadge HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-4,0"
                        Value="{Binding PluginDownloadQueueCount}" IsHitTestVisible="False"
                        Visibility="{Binding HasActivePluginDownloadQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <ui:Button Icon="{ui:SymbolIcon Settings24}" ToolTip="{lex:Loc PluginMarketSettingsTitle}"
                    AutomationProperties.Name="{lex:Loc PluginMarketSettingsTitle}" Command="{Binding TogglePluginMarketSettingsCommand}">
                    <TextBlock x:Name="SettingsLabel" lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common" Text="{lex:Loc Settings}" />
                </ui:Button>
            </WrapPanel>
            <TextBlock Text="{lex:Loc PluginMarket}" VerticalAlignment="Center" FontSize="20"
                FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <frame:ModernFrame x:Name="MarketFrame" Grid.Row="1" TransitionDuration="0:0:0.333"
            ContentScrollHostMode="Auto" ResetScrollOnNavigation="False" />
    </Grid>
</UserControl>
