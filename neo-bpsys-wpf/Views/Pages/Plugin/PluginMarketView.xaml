<UserControl
    x:Class="neo_bpsys_wpf.Views.Pages.Plugin.PluginMarketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:frame="clr-namespace:neo_bpsys_wpf.Controls.Modern.Frame"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.PluginMarket"
    scrolling:ModernScroll.Ownership="Self"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    PreviewKeyDown="OnPreviewKeyDown"
    SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="8,12,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16" LastChildFill="True">
            <ui:Button
                x:Name="BackButton"
                Margin="0,0,12,0"
                Appearance="Transparent"
                AutomationProperties.Name="{lex:Loc MarketBackToBrowse}"
                Command="{Binding ClosePluginMarketOverlaysCommand}"
                DockPanel.Dock="Left"
                Icon="{ui:SymbolIcon ArrowLeft24}"
                ToolTip="{lex:Loc MarketBackToBrowse}"
                Visibility="{Binding HasPluginMarketOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock x:Name="BackLabel" Text="{lex:Loc MarketBackToBrowse}" />
            </ui:Button>
            <WrapPanel HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Grid Margin="0,0,8,0">
                    <ui:Button
                        AutomationProperties.Name="{lex:Loc PluginMarketDownloadQueue}"
                        Command="{Binding ToggleDownloadQueueCommand}"
                        Icon="{ui:SymbolIcon ArrowDownload24}"
                        ToolTip="{lex:Loc PluginMarketDownloadQueue}">
                        <TextBlock x:Name="DownloadsLabel" Text="{lex:Loc PluginMarketDownloadQueue}" />
                    </ui:Button>
                    <ui:InfoBadge
                        Margin="0,-5,-4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasActivePluginDownloadQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Value="{Binding PluginDownloadQueueCount}" />
                </Grid>
                <ui:Button
                    AutomationProperties.Name="{lex:Loc PluginMarketSettingsTitle}"
                    Command="{Binding TogglePluginMarketSettingsCommand}"
                    Icon="{ui:SymbolIcon Settings24}"
                    ToolTip="{lex:Loc PluginMarketSettingsTitle}">
                    <TextBlock
                        x:Name="SettingsLabel"
                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                        Text="{lex:Loc Settings}" />
                </ui:Button>
            </WrapPanel>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{lex:Loc PluginMarket}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <frame:ModernFrame
            x:Name="MarketFrame"
            Grid.Row="1"
            ContentScrollHostMode="Auto"
            ResetScrollOnNavigation="False"
            TransitionDuration="0:0:0.333" />
    </Grid>
</UserControl>
