<UserControl
    x:Class="neo_bpsys_wpf.Views.Pages.Plugin.PluginInstalledView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=vm:PluginPageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="900"
    d:DesignWidth="685"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.PluginMarket"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:ListView
            Grid.Row="1"
            Margin="0,10,0,0"
            ItemsSource="{Binding PluginsCollection}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ui:ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ui:ListView.ItemContainerStyle>
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander HorizontalAlignment="Stretch">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Image
                                    Grid.Column="0"
                                    Width="64"
                                    Height="64"
                                    Margin="0,0,15,0"
                                    CornerRadius="8"
                                    Source="{Binding RealIconPath}" />
                                <StackPanel
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{Binding Manifest.Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Manifest.Name}" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        FontSize="14"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Manifest.Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Manifest.Author, StringFormat='By {0}'}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Manifest.Version, StringFormat='v{0}'}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="DarkOrange"
                                            Text="{Binding NewVersion, StringFormat=' -> v{0}'}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsNewVersionInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Foreground="Orange"
                                        Text="{lex:Loc RestartToApplyChanges}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding IsRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ui:ToggleSwitch
                                        Margin="0,0,10,0"
                                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                        Command="{Binding DataContext.ToggleEnableCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                        CommandParameter="{Binding}"
                                        IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                        ToolTip="{lex:Loc Enable}" />

                                    <ui:Button
                                        MinWidth="36"
                                        Appearance="Danger"
                                        Command="{Binding DataContext.ToggleUninstallCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="{lex:Loc Uninstall}">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{lex:Loc Uninstall}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUninstalling}" Value="True">
                                                            <Setter Property="Text" Value="{lex:Loc CancelUninstall}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter Property="Text" Value="{lex:Loc PluginNotRemovable}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{lex:Loc ProjectUrl}" />
                                <ui:HyperlinkButton
                                    Grid.Column="1"
                                    NavigateUri="{Binding Manifest.Url}"
                                    ToolTip="{Binding Manifest.Url}">
                                    <TextBlock Text="{Binding Manifest.Url}" TextTrimming="CharacterEllipsis" />
                                </ui:HyperlinkButton>
                            </Grid>
                            <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow">
                                <Run Text="{lex:Loc PluginStatus}" />
                                <Run Text="{lex:Loc {Binding ExceptionText}, FallbackBehavior=Key}" />
                            </TextBlock>
                        </StackPanel>
                    </ui:CardExpander>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</UserControl>
