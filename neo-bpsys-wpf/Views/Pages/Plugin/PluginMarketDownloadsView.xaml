<UserControl
    x:Class="neo_bpsys_wpf.Views.Pages.Plugin.PluginMarketDownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:motion="clr-namespace:neo_bpsys_wpf.Controls.Modern.Motion"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="DownloadsRoot"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.PluginMarket"
    scrolling:ModernScroll.Ownership="Self">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{lex:Loc PluginMarketDownloadQueueTitle}" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{lex:Loc MarketDownloadsHint}"
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ListBox
                x:Name="Queue"
                motion:ListTransitions.IsEnabled="True"
                scrolling:ModernScroll.Ownership="Self"
                scrolling:NestedSmoothScrollBehavior.IsEnabled="True"
                AutomationProperties.Name="{lex:Loc PluginMarketDownloadQueueTitle}"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding PluginDownloadQueue}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding PluginName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="20"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock
                                        Margin="0,0,12,4"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{Binding PluginName}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding PluginVersion, StringFormat=v{0}}" />
                                </WrapPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Shell"
                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    Text="{lex:Loc {Binding StatusKey},
                                                   FallbackBehavior=Key}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    Height="4"
                                    Margin="0,12,0,0"
                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding Progress}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock
                                        Margin="0,0,16,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ProgressText}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SpeedText}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                        Appearance="Secondary"
                                        Command="{Binding DataContext.PausePluginMarketQueueItemCommand, ElementName=DownloadsRoot}"
                                        CommandParameter="{Binding}"
                                        Content="{lex:Loc PauseDownload}"
                                        Icon="{ui:SymbolIcon Pause24}"
                                        Visibility="{Binding CanPause, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                        Appearance="Secondary"
                                        Command="{Binding DataContext.ResumePluginMarketQueueItemCommand, ElementName=DownloadsRoot}"
                                        CommandParameter="{Binding}"
                                        Content="{lex:Loc ResumeDownload}"
                                        Icon="{ui:SymbolIcon Play24}"
                                        Visibility="{Binding CanResume, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        Margin="0,0,0,8"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.CancelPluginMarketQueueItemCommand, ElementName=DownloadsRoot}"
                                        CommandParameter="{Binding}"
                                        Content="{lex:Loc PluginMarketCancelDownload}"
                                        Icon="{ui:SymbolIcon Dismiss24}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </WrapPanel>
                                <TextBlock
                                    motion:ContentEntrance.IsEnabled="True"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                motion:ContentEntrance.IsEnabled="True">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=Queue}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon
                    FontSize="36"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="ArrowDownload24" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{lex:Loc PluginMarketDownloadQueueEmpty}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>