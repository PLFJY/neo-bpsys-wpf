<UserControl
    x:Class="neo_bpsys_wpf.Views.Pages.Plugin.PluginMarketSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:neo_bpsys_wpf.Converters"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:motion="clr-namespace:neo_bpsys_wpf.Controls.Modern.Motion"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.PluginMarket"
    scrolling:ModernScroll.Ownership="Self">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:LatencyToBrushConverter x:Key="LatencyToBrushConverter" />
    </UserControl.Resources>
    <scrolling:ModernScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,16">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="24"
                FontWeight="SemiBold"
                Text="{lex:Loc PluginMarketSettingsTitle}" />
            <Border
                Padding="24"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{lex:Loc PluginMarketSourceLabel}" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{lex:Loc MarketSourceHint}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        HorizontalContentAlignment="Stretch"
                        scrolling:ComboBoxDropdownSmoothScrollBehavior.IsEnabled="True"
                        AutomationProperties.Name="{lex:Loc PluginMarketSourceLabel}"
                        ItemsSource="{Binding PluginMarketSourceOptions}"
                        SelectedValue="{Binding SelectedPluginMarketSource, Mode=TwoWay}"
                        SelectedValuePath="Value">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding DisplayNameKey}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Value}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border
                Margin="0,12,0,0"
                Padding="24"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsPluginMarketMirrorSettingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{lex:Loc PluginMarketMirrorLabel}" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{lex:Loc PluginMarketMirrorSyncHint}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        HorizontalContentAlignment="Stretch"
                        scrolling:ComboBoxDropdownSmoothScrollBehavior.IsEnabled="True"
                        AutomationProperties.Name="{lex:Loc PluginMarketMirrorLabel}"
                        ItemsSource="{Binding PluginMarketMirrorOptions}"
                        SelectedValue="{Binding SelectedPluginMarketMirror, Mode=TwoWay}"
                        SelectedValuePath="Value">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        DockPanel.Dock="Right"
                                        Foreground="{Binding LatencyMs, Converter={StaticResource LatencyToBrushConverter}}"
                                        Text="{Binding LatencyDisplayText}" />
                                    <TextBlock
                                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                        Text="{lex:Loc {Binding DisplayNameKey},
                                                       FallbackBehavior=Key}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Settings"
                            Command="{Binding TestPluginMarketMirrorLatencyCommand}"
                            Content="{lex:Loc TestMirrorLatency}"
                            Icon="{ui:SymbolIcon Flash24}" />
                        <StackPanel
                            Margin="12,0,0,0"
                            motion:ContentEntrance.IsEnabled="True"
                            Orientation="Horizontal"
                            Visibility="{Binding IsTestingPluginMarketMirrorLatency, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:ProgressRing
                                Width="20"
                                Height="20"
                                IsIndeterminate="True" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{lex:Loc MarketTestingMirrors}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </scrolling:ModernScrollViewer>
</UserControl>