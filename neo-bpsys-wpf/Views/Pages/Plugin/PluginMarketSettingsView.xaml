<UserControl x:Class="neo_bpsys_wpf.Views.Pages.Plugin.PluginMarketSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:cv="clr-namespace:neo_bpsys_wpf.Converters"
    xmlns:scrolling="clr-namespace:neo_bpsys_wpf.Controls.Modern.Scrolling"
    xmlns:motion="clr-namespace:neo_bpsys_wpf.Controls.Modern.Motion"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.PluginMarket"
    scrolling:ModernScroll.Ownership="Self">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:LatencyToBrushConverter x:Key="LatencyToBrushConverter" />
    </UserControl.Resources>
    <scrolling:ModernScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,16">
            <TextBlock Text="{lex:Loc PluginMarketSettingsTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc PluginMarketSourceLabel}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{lex:Loc MarketSourceHint}" Margin="0,8,0,16" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding PluginMarketSourceOptions}" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{lex:Loc PluginMarketSourceLabel}"
                        scrolling:ComboBoxDropdownSmoothScrollBehavior.IsEnabled="True"
                        SelectedValue="{Binding SelectedPluginMarketSource, Mode=TwoWay}" SelectedValuePath="Value">
                        <ComboBox.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding DisplayNameKey}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                        </DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="24" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding IsPluginMarketMirrorSettingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc PluginMarketMirrorLabel}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{lex:Loc PluginMarketMirrorSyncHint}" Margin="0,8,0,16" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding PluginMarketMirrorOptions}" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{lex:Loc PluginMarketMirrorLabel}"
                        scrolling:ComboBoxDropdownSmoothScrollBehavior.IsEnabled="True"
                        SelectedValue="{Binding SelectedPluginMarketMirror, Mode=TwoWay}" SelectedValuePath="Value">
                        <ComboBox.ItemTemplate><DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyDisplayText}" Margin="12,0,0,0"
                                    Foreground="{Binding LatencyMs, Converter={StaticResource LatencyToBrushConverter}}" />
                                <TextBlock lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                    Text="{lex:Loc {Binding DisplayNameKey}, FallbackBehavior=Key}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Settings"
                            Content="{lex:Loc TestMirrorLatency}" Icon="{ui:SymbolIcon Flash24}" Command="{Binding TestPluginMarketMirrorLatencyCommand}" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" motion:ContentEntrance.IsEnabled="True"
                            Visibility="{Binding IsTestingPluginMarketMirrorLatency, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                            <TextBlock Text="{lex:Loc MarketTestingMirrors}" Margin="8,0,0,0" VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </scrolling:ModernScrollViewer>
</UserControl>