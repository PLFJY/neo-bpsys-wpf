<Page
    x:Class="neo_bpsys_wpf.Views.Pages.TeamInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:neo_bpsys_wpf.Controls"
    xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
    xmlns:cv="clr-namespace:neo_bpsys_wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:neo_bpsys_wpf.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    Title="TeamInfoPage"
    d:DataContext="{d:DesignInstance Type=vm:TeamInfoPageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="2000"
    d:DesignWidth="685"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Team"
    mc:Ignorable="d">
    <Page.Resources>
        <cv:CampToStringConverter x:Key="CampToStringConverter" />
        <cv:DictionaryLocalizationConverter x:Key="CommonDictionaryLocalizationConverter" />
        <cv:BooleanToReverseVisibilityConverter x:Key="BooleanToReverseVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="SurMemberItemTemplate">
            <Grid Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="{lex:Loc PlayerName}"
                    Text="{Binding Name}" />
                <ToggleButton
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.SwitchMemberStateCommand}"
                    CommandParameter="{Binding}"
                    IsChecked="{Binding IsOnField}"
                    IsEnabled="{Binding CanOnFieldChange}">
                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
                            <Setter Property="Background" Value="DarkGreen" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowUpload24" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
                                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Team"
                                            Text="{lex:Loc Enter}" />
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="DarkRed" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
                                                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Team"
                                                    Text="{lex:Loc Exit}" />
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ui:Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.EditMemberDetailsCommand}"
                    CommandParameter="{Binding}"
                    Content="{lex:Loc More}"
                    Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}" />
                <ui:Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Background="PaleVioletRed"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.RemoveSurMemberCommand}"
                    CommandParameter="{Binding}"
                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                    Content="{lex:Loc Delete}"
                    Icon="{ui:SymbolIcon Symbol=Delete24}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HunMemberItemTemplate">
            <Grid Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="{lex:Loc PlayerName}"
                    Text="{Binding Name}" />
                <ToggleButton
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.SwitchMemberStateCommand}"
                    CommandParameter="{Binding}"
                    IsChecked="{Binding IsOnField}"
                    IsEnabled="{Binding CanOnFieldChange}">
                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
                            <Setter Property="Background" Value="DarkGreen" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowUpload24" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
                                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Team"
                                            Text="{lex:Loc Enter}" />
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="DarkRed" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
                                                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Team"
                                                    Text="{lex:Loc Exit}" />
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ui:Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.EditMemberDetailsCommand}"
                    CommandParameter="{Binding}"
                    Content="{lex:Loc More}"
                    Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}" />
                <ui:Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Background="PaleVioletRed"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.RemoveHunMemberCommand}"
                    CommandParameter="{Binding}"
                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                    Content="{lex:Loc Delete}"
                    Icon="{ui:SymbolIcon Symbol=Delete24}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <WrapPanel Orientation="Horizontal">
        <!--  home team  -->
        <Border DataContext="{Binding HomeTeamInfoViewModel}" Style="{StaticResource Card}">
            <!--  basic info  -->
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Title}" Text="{lex:Loc HomeTeamInformation}" />
                    <ui:Button
                        x:Name="HomeTeamJsonImportButton"
                        Margin="10,0,0,0"
                        Command="{Binding ImportInfoFromJsonCommand}"
                        Content="{lex:Loc ImportFromJsonFile}"
                        Icon="{ui:SymbolIcon Symbol=ArrowImport24}"
                        ToolTipService.InitialShowDelay="100"
                        ToolTipService.Placement="MousePoint"
                        ToolTipService.ToolTip="{lex:Loc JsonImportTip}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <ui:TextBox
                        x:Name="HomeTeamNameInput"
                        Width="250"
                        PlaceholderText="{lex:Loc TeamName}"
                        Text="{Binding TeamName}" />
                    <ui:Button
                        x:Name="HomeTeamNameConfirmButton"
                        Margin="10,0,0,0"
                        Command="{Binding ConfirmTeamNameCommand}"
                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                        Content="{lex:Loc Confirm}"
                        Icon="{ui:SymbolIcon Symbol=Checkmark24}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{lex:Loc TeamColor}" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <colorpicker:PortableColorPicker
                            Width="60"
                            Height="30"
                            SelectedColor="{Binding TeamColorPickerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource DefaultColorPickerStyle}" />
                        <ui:TextBox
                            Width="150"
                            Margin="10,0,0,0"
                            KeyDown="TeamColorTextBox_OnKeyDown"
                            MaxLength="9"
                            PlaceholderText="{lex:Loc HexColor}"
                            Text="{Binding TeamColorHexEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Margin="10,0,0,0"
                            Command="{Binding ApplyTeamColorCommand}"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                            Content="{lex:Loc ApplyColor}"
                            Icon="{ui:SymbolIcon Symbol=Checkmark24}" />
                        <ui:Button
                            Margin="10,0,0,0"
                            Command="{Binding ResetTeamColorCommand}"
                            Content="{lex:Loc ResetDefaultColor}"
                            Icon="{ui:SymbolIcon Symbol=ArrowReset24}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding TeamColorStatus}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="HomeTeamLogoButton"
                        Command="{Binding SetTeamLogoCommand}"
                        Content="{lex:Loc SetTeamLogo}"
                        Icon="{ui:SymbolIcon Symbol=ImageEdit24}" />
                    <ui:Image
                        Width="70"
                        Height="70"
                        Margin="20,10,0,10"
                        CornerRadius="8"
                        Source="{Binding CurrentTeam.Logo}"
                        Stretch="UniformToFill" />
                    <TextBlock
                        Width="150"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">
                        <Run Text="{lex:Loc CurrentStatusColon}" /><Run d:Text="求生者" Text="{Binding CurrentTeam.Camp, Mode=OneWay, Converter={StaticResource CommonDictionaryLocalizationConverter}, ConverterParameter=Locales.Common}" />
                    </TextBlock>

                </StackPanel>

                <!--  player edit  -->

                <!--  sur  -->
                <StackPanel x:Name="HomePlayerListPanel">
                    <TextBlock Text="{lex:Loc SurvivorPlayer}" />
                    <ItemsControl
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource SurMemberItemTemplate}"
                        ItemsSource="{Binding CurrentTeam.SurMemberList}" />
                    <ui:Button
                        Command="{Binding AddSurMemberCommand}"
                        Content="{lex:Loc AddPlayer}"
                        Icon="{ui:SymbolIcon Symbol=Add24}" />
                </StackPanel>
                <!--  hun  -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{lex:Loc HunterPlayer}" />
                    <ItemsControl
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource HunMemberItemTemplate}"
                        ItemsSource="{Binding CurrentTeam.HunMemberList}" />
                    <ui:Button
                        Command="{Binding AddHunMemberCommand}"
                        Content="{lex:Loc AddPlayer}"
                        Icon="{ui:SymbolIcon Symbol=Add24}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  away team  -->
        <Border
            x:Name="AwayTeamInfoCard"
            DataContext="{Binding AwayTeamInfoViewModel}"
            Style="{StaticResource Card}">
            <!--  basic info  -->
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Title}" Text="{lex:Loc AwayTeamInformation}" />
                    <ui:Button
                        x:Name="AwayTeamJsonImportButton"
                        Margin="10,0,0,0"
                        Command="{Binding ImportInfoFromJsonCommand}"
                        Content="{lex:Loc ImportFromJsonFile}"
                        Icon="{ui:SymbolIcon Symbol=ArrowImport24}"
                        ToolTipService.InitialShowDelay="100"
                        ToolTipService.Placement="MousePoint"
                        ToolTipService.ToolTip="{lex:Loc JsonImportTip}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <ui:TextBox
                        x:Name="AwayTeamNameInput"
                        Width="250"
                        PlaceholderText="{lex:Loc TeamName}"
                        Text="{Binding TeamName}" />
                    <ui:Button
                        x:Name="AwayTeamNameConfirmButton"
                        Margin="10,0,0,0"
                        Command="{Binding ConfirmTeamNameCommand}"
                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                        Content="{lex:Loc Confirm}"
                        Icon="{ui:SymbolIcon Symbol=Checkmark24}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{lex:Loc TeamColor}" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <colorpicker:PortableColorPicker
                            Width="60"
                            Height="30"
                            SelectedColor="{Binding TeamColorPickerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource DefaultColorPickerStyle}" />
                        <ui:TextBox
                            Width="150"
                            Margin="10,0,0,0"
                            KeyDown="TeamColorTextBox_OnKeyDown"
                            MaxLength="9"
                            PlaceholderText="{lex:Loc HexColor}"
                            Text="{Binding TeamColorHexEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Margin="10,0,0,0"
                            Command="{Binding ApplyTeamColorCommand}"
                            lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                            Content="{lex:Loc ApplyColor}"
                            Icon="{ui:SymbolIcon Symbol=Checkmark24}" />
                        <ui:Button
                            Margin="10,0,0,0"
                            Command="{Binding ResetTeamColorCommand}"
                            Content="{lex:Loc ResetDefaultColor}"
                            Icon="{ui:SymbolIcon Symbol=ArrowReset24}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding TeamColorStatus}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="AwayTeamLogoButton"
                        Command="{Binding SetTeamLogoCommand}"
                        Content="{lex:Loc SetTeamLogo}"
                        Icon="{ui:SymbolIcon Symbol=ImageEdit24}" />
                    <ui:Image
                        Width="70"
                        Height="70"
                        Margin="20,10,0,10"
                        CornerRadius="8"
                        Source="{Binding CurrentTeam.Logo}"
                        Stretch="UniformToFill" />
                    <TextBlock
                        Width="150"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">
                        <Run Text="{lex:Loc CurrentStatusColon}" /><Run d:Text="监管者" Text="{Binding CurrentTeam.Camp, Mode=OneWay, Converter={StaticResource CommonDictionaryLocalizationConverter}, ConverterParameter=Locales.Common}" />
                    </TextBlock>
                </StackPanel>

                <!--  player edit  -->

                <!--  sur  -->
                <StackPanel x:Name="AwayPlayerListPanel">
                    <TextBlock Text="{lex:Loc SurvivorPlayer}" />
                    <ItemsControl
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource SurMemberItemTemplate}"
                        ItemsSource="{Binding CurrentTeam.SurMemberList}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding AddSurMemberCommand}"
                            Content="{lex:Loc AddPlayer}"
                            Icon="{ui:SymbolIcon Symbol=Add24}" />
                    </StackPanel>
                </StackPanel>
                <!--  hun  -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{lex:Loc HunterPlayer}" />
                    <ItemsControl
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource HunMemberItemTemplate}"
                        ItemsSource="{Binding CurrentTeam.HunMemberList}" />
                    <ui:Button
                        Command="{Binding AddHunMemberCommand}"
                        Content="{lex:Loc AddPlayer}"
                        Icon="{ui:SymbolIcon Symbol=Add24}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  current  -->
        <Border x:Name="TeamSummaryCard" Style="{StaticResource Card}">
            <Border.Resources>
                <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">
                    <!--<Setter Property="PlaceholderText" Value="选手名称" /> -->
                    <Setter Property="MinWidth" Value="250" />
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                </Style>
                <Style BasedOn="{StaticResource {x:Type cc:CharacterChanger}}" TargetType="cc:CharacterChanger">
                    <Setter Property="Spacing" Value="10" />
                    <Setter Property="Margin" Value="10,0,0,0" />
                </Style>
            </Border.Resources>
            <StackPanel>
                <TextBlock Style="{StaticResource Title}" Text="{lex:Loc CurrentPlayerOnStage}" />
                <TextBlock
                    Margin="0,10,0,0"
                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                    Text="{lex:Loc Survivor}" />
                <ItemsControl
                    x:Name="HomePlayerPositionPanel"
                    Margin="0,10,0,0"
                    ItemsSource="{Binding OnFieldSurPlayerViewModels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <ui:TextBox PlaceholderText="{lex:Loc PlayerName}" Text="{Binding ThisPlayer.Member.Name}" />
                                <cc:CharacterChanger Command="{Binding SwapMembersInPlayersCommand}" Index="{Binding Index}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,10,0,10"
                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                    Text="{lex:Loc Hunter}" />
                <ui:TextBox
                    x:Name="AwayPlayerPositionPanel"
                    PlaceholderText="{lex:Loc PlayerName}"
                    Text="{Binding OnFieldHunPlayerVm.ThisPlayer.Member.Name}" />
            </StackPanel>
        </Border>
    </WrapPanel>
</Page>
