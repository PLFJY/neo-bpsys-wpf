<Page
    x:Class="neo_bpsys_wpf.Views.Pages.PluginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modernNavigation="clr-namespace:neo_bpsys_wpf.Controls.Modern.Navigation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    Title="PluginPage"
    d:DataContext="{d:DesignInstance Type=vm:PluginPageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="1500"
    d:DesignWidth="685"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.PluginMarket"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,10"
                Orientation="Horizontal">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="{lex:Loc PluginManagement}" />
                <ui:Button
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Command="{Binding RestartAppCommand}"
                    Content="{lex:Loc ClickToRestart}"
                    Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                    MouseOverBackground="{DynamicResource SystemAccentColorSecondaryBrush}"
                    PressedBackground="{DynamicResource SystemAccentColorTertiaryBrush}"
                    Visibility="{Binding IsRestartNeeded, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <ui:Button
                HorizontalAlignment="Right"
                Command="{Binding InstallPluginFromFileCommand}"
                Content="{lex:Loc InstallPluginFromFile}"
                Icon="{ui:SymbolIcon Symbol=CubeArrowCurveDown20}" />
        </Grid>

        <modernNavigation:ModernNavigationView
            x:Name="PluginTabs"
            Grid.Row="1"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            NavigationBehavior="LocalTabs"
            PaneDisplayMode="Top"
            TransitionDuration="220" />
    </Grid>
</Page>
