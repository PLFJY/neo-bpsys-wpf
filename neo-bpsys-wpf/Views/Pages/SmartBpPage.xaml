<Page
    x:Class="neo_bpsys_wpf.Views.Pages.SmartBpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:neo_bpsys_wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    Title="SmartBpPage"
    d:DataContext="{d:DesignInstance Type=vm:SmartBpPageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="900"
    d:DesignWidth="770"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:BooleanToReverseVisibilityConverter x:Key="BooleanToReverseVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="10,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl
            x:Name="SmartBpModuleContentHost"
            Grid.Row="0"
            Content="{Binding ModuleContent}" />
        <TextBlock
            Grid.Row="1"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ModuleVersionText}"
            Visibility="{Binding IsModuleVersionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Border
            Grid.RowSpan="2"
            Padding="40"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            Visibility="{Binding IsModuleLoaded, Converter={StaticResource BooleanToReverseVisibilityConverter}}">
            <Grid>
                <StackPanel
                    MaxWidth="620"
                    Margin="0,72,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="{lex:Loc SmartBp}" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Text="{Binding OverlayMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            MinWidth="440"
                            Text="{Binding SelectedModulePath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Command="{Binding BrowseModulePathCommand}"
                            Content="{lex:Loc SmartBpModuleBrowseFolder}"
                            Icon="{ui:SymbolIcon Symbol=Folder24}" />
                    </Grid>
                    <ui:Button
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding PrimaryActionCommand}"
                        Content="{Binding PrimaryActionText}"
                        Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                    <ui:Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding SelectInstalledModuleFolderCommand}"
                        Content="{lex:Loc SmartBpModuleSelectInstalledPath}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                        Visibility="{Binding IsSelectInstalledModuleButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ImportModuleZipCommand}"
                        Content="{lex:Loc SmartBpModuleSelectArchive}"
                        Icon="{ui:SymbolIcon Symbol=Archive24}" />
                    <ui:ProgressRing
                        Width="28"
                        Height="28"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    </ui:ProgressRing>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
