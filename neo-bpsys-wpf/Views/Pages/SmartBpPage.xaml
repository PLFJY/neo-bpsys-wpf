<Page
    x:Class="neo_bpsys_wpf.Views.Pages.SmartBpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:neo_bpsys_wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    Title="SmartBpPage"
    d:DataContext="{d:DesignInstance Type=vm:SmartBpPageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="900"
    d:DesignWidth="770"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Settings"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:BooleanToReverseVisibilityConverter x:Key="BooleanToReverseVisibilityConverter" />
        <cv:LatencyToBrushConverter x:Key="LatencyToBrushConverter" />
    </Page.Resources>

    <Grid Margin="10,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl
            x:Name="SmartBpModuleContentHost"
            Grid.Row="0"
            Content="{Binding ModuleContent}" />
        <TextBlock
            Grid.Row="1"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ModuleVersionText}"
            Visibility="{Binding IsModuleVersionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Border
            Grid.RowSpan="2"
            Padding="40"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            Visibility="{Binding IsModuleLoaded, Converter={StaticResource BooleanToReverseVisibilityConverter}}">
            <Grid>
                <StackPanel
                    MaxWidth="620"
                    Margin="0,72,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        FontSize="48"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="ScanText24" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Shell"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="{lex:Loc SmartBp}" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Text="{Binding OverlayMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ui:Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding PrimaryActionCommand}"
                        Content="{Binding PrimaryActionText}"
                        Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                    <ProgressBar
                        Width="280"
                        Height="8"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        IsIndeterminate="{Binding IsProgressIndeterminate}"
                        Maximum="100"
                        Minimum="0"
                        Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Value="{Binding ProgressValue, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ProgressValue, StringFormat={}{0:0}%, Mode=OneWay}"
                        Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Secondary"
                        Command="{Binding ToggleAdvancedOptionsCommand}"
                        Content="{lex:Loc SmartBpModuleAdvancedOptions}">
                        <ui:Button.Resources>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvancedOptionsExpanded}" Value="true">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Symbol=ChevronDown24}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAdvancedOptionsExpanded}" Value="false">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Symbol=ChevronRight24}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Resources>
                    </ui:Button>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAdvancedOptionsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                x:Name="SmartBpModulePathTextBox"
                                Grid.Column="0"
                                MinWidth="440"
                                Text="{Binding SelectedModulePath, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                x:Name="SmartBpModuleBrowseFolderButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Command="{Binding BrowseModulePathCommand}"
                                Content="{lex:Loc SmartBpModuleBrowseFolder}"
                                Icon="{ui:SymbolIcon Symbol=Folder24}" />
                        </Grid>
                        <StackPanel
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding IsSmartBpModuleMirrorSettingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock VerticalAlignment="Center" Text="{lex:Loc DownloadSource}" />
                            <ComboBox
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding SmartBpModuleMirrorOptions}"
                                SelectedValue="{Binding SelectedSmartBpModuleMirror, Mode=TwoWay}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                                Text="{lex:Loc {Binding DisplayNameKey},
                                                               FallbackBehavior=Key}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding LatencyMs, Converter={StaticResource LatencyToBrushConverter}}"
                                                Text="{Binding LatencyDisplayText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:Button
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding TestSmartBpModuleMirrorLatencyCommand}"
                                Content="{lex:Loc TestMirrorLatency}"
                                Icon="{ui:SymbolIcon Symbol=Flash24}" />
                        </StackPanel>
                        <ui:Button
                            x:Name="SmartBpSelectInstalledModulePathButton"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding SelectInstalledModuleFolderCommand}"
                            Content="{lex:Loc SmartBpModuleSelectInstalledPath}"
                            Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                            Visibility="{Binding IsSelectInstalledModuleButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:Button
                            x:Name="SmartBpImportModuleArchiveButton"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding ImportModuleZipCommand}"
                            Content="{lex:Loc SmartBpModuleSelectArchive}"
                            Icon="{ui:SymbolIcon Symbol=Archive24}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
