<Page
    x:Class="neo_bpsys_wpf.Views.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
    xmlns:cv="clr-namespace:neo_bpsys_wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:neo_bpsys_wpf.Core.Enums;assembly=neo-bpsys-wpf.Core"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:neo_bpsys_wpf.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    Title="SettingPage"
    d:DataContext="{d:DesignInstance Type=vm:SettingPageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="2500"
    d:DesignWidth="685"
    lex:ResxLocalizationProvider.DefaultAssembly="neo-bpsys-wpf"
    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Settings"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:BooleanToReverseVisibilityConverter x:Key="BooleanToReverseVisibilityConverter" />
        <cv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <cv:LatencyToBrushConverter x:Key="LatencyToBrushConverter" />
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </Page.Resources>
    <StackPanel Margin="10,0,10,0">
        <TextBlock
            d:Text="语言设置"
            Style="{StaticResource Title}"
            Text="{lex:Loc LanguageSetting}" />
        <Border Style="{StaticResource Card}">
            <ComboBox
                x:Name="LanguageComboBox"
                Width="300"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                ItemsSource="{Binding LanguageList}"
                SelectedValue="{Binding SelectedLanguage}"
                SelectedValuePath="Value">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common" Text="{lex:Loc {Binding Key}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Border>
        <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Title}"
            Text="{lex:Loc About}" />
        <StackPanel Margin="0,10,0,0">
            <ui:CardExpander
                Margin="0,0,0,12"
                Icon="{ui:ImageIcon 'pack://application:,,,/Assets/icon.png',
                                    Width=50,
                                    Height=50}"
                IsExpanded="True">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ui:TextBlock
                                Grid.Row="0"
                                FontSize="18"
                                FontTypography="Body">
                                <Run Text="neo-bpsys-wpf --" />
                                <Run lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common" Text="{lex:Loc VersionName}" />
                            </ui:TextBlock>
                            <ui:TextBlock
                                Grid.Row="2"
                                Margin="0,5,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{lex:Loc AuthorDetails}" />
                        </Grid>
                        <ui:TextBlock
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding AppVersion}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>

                        </Grid.Resources>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="neo-bpsys-wpf is licenced under GPLv3 licence" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock Text="Powered by" />
                            <ui:ImageIcon
                                Width="25"
                                Height="25"
                                Margin="5,0,5,0"
                                Source="/Assets/logo_net.jpg " />
                            <TextBlock Text="10.0 &amp; " />
                            <ui:ImageIcon
                                Width="25"
                                Height="25"
                                Margin="5,0,5,0"
                                Source="/Assets/wpfui.png" />
                            <TextBlock Text="WPF UI 4.3.0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc ProjectRepository}" />
                        <ui:HyperlinkButton
                            Grid.Column="1"
                            Content="https://github.com/PLFJY/neo-bpsys-wpf"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            NavigateUri="https://github.com/PLFJY/neo-bpsys-wpf" />
                    </Grid>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{lex:Loc SoftwareUpdates}" />
                        <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <StackPanel
                                Margin="0,0,10,8"
                                d:Visibility="Visible"
                                Orientation="Horizontal"
                                Visibility="{Binding IsGitHubMirrorSettingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock VerticalAlignment="Center" Text="{lex:Loc DownloadSource}" />
                                <ComboBox
                                    Margin="10,0,0,0"
                                    ItemsSource="{Binding MirrorList}"
                                    SelectedValue="{Binding Mirror}"
                                    SelectedValuePath="Value">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                                    Text="{lex:Loc {Binding DisplayNameKey},
                                                                   FallbackBehavior=Key}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding LatencyMs, Converter={StaticResource LatencyToBrushConverter}}"
                                                    Text="{Binding LatencyDisplayText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ui:Button
                                    Margin="10,0,0,0"
                                    Command="{Binding TestMirrorLatencyCommand}"
                                    Content="{lex:Loc TestMirrorLatency}"
                                    Icon="{ui:SymbolIcon Symbol=Flash24}"
                                    IsEnabled="{Binding IsTestingLatency, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,0,10,8"
                                VerticalAlignment="Center"
                                Text="{lex:Loc DownloadPreviewVersion}" />
                            <ui:ToggleSwitch Margin="0,0,10,8" IsChecked="{Binding IsFindPreRelease, Mode=TwoWay}" />
                        </WrapPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding UpdateCheckCommand}"
                                Content="{lex:Loc CheckForUpdates}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Margin="10,0,0,0"
                                Command="{Binding InstallUpdateCommand}"
                                Content="{lex:Loc Install}"
                                Icon="{ui:SymbolIcon Symbol=DrawerArrowDownload24}" />
                            <StackPanel
                                Margin="10,0,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding IsUpdateDownloadProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:ProgressRing
                                    Width="26"
                                    Height="26"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsDownloadPaused, Converter={StaticResource BooleanToReverseVisibilityConverter}}" />
                                <ProgressBar
                                    Width="175"
                                    Height="20"
                                    Margin="10,0,0,0"
                                    d:Value="50"
                                    Value="{Binding DownloadProgress}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    d:Text="50.00%"
                                    Text="{Binding DownloadProgressText}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    d:Text="10.00 Mb/s"
                                    Text="{Binding MbPerSecondSpeed}" />
                                <ui:Button
                                    Margin="10,0,0,0"
                                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                    Command="{Binding PauseDownloadCommand}"
                                    Content="{lex:Loc PauseDownload}"
                                    Icon="{ui:SymbolIcon Symbol=Pause24}"
                                    Visibility="{Binding IsDownloadPaused, Converter={StaticResource BooleanToReverseVisibilityConverter}}" />
                                <ui:Button
                                    Margin="10,0,0,0"
                                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                    Command="{Binding ResumeDownloadCommand}"
                                    Content="{lex:Loc ResumeDownload}"
                                    Icon="{ui:SymbolIcon Symbol=Play24}"
                                    Visibility="{Binding IsDownloadPaused, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:Button
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                    Command="{Binding CancelDownloadCommand}"
                                    Content="{lex:Loc Stop}"
                                    Icon="{ui:SymbolIcon Symbol=Stop24}"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsUpdateHashVerificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{lex:Loc AppUpdateVerifyingHash}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Margin="0,20,0,0"
                        FontWeight="DemiBold"
                        Text="{lex:Loc SourceOfImageResources}" />
                    <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <WrapPanel.Resources>
                            <Style BasedOn="{StaticResource {x:Type ui:HyperlinkButton}}" TargetType="ui:HyperlinkButton">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Style>
                        </WrapPanel.Resources>
                        <ui:HyperlinkButton
                            Margin="0,0,10,10"
                            Content="第五人格BWiki"
                            NavigateUri="https://wiki.biligame.com/" />
                        <ui:HyperlinkButton
                            Margin="0,0,10,10"
                            Content="Fandom Identity V Wiki"
                            NavigateUri="https://id5.fandom.com/wiki/Identity_V_Wiki/" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontWeight="DemiBold"
                        Text="{lex:Loc OpenSourceRepositoryUsed}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.Resources>
                            <Style BasedOn="{StaticResource {x:Type ui:HyperlinkButton}}" TargetType="ui:HyperlinkButton">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding OpenSourceRepoColumn1}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:HyperlinkButton Content="{Binding Name}" NavigateUri="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding OpenSourceRepoColumn2}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:HyperlinkButton Content="{Binding Name}" NavigateUri="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding OpenSourceRepoColumn3}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:HyperlinkButton Content="{Binding Name}" NavigateUri="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
        <Border Margin="0,10,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock
                        FontSize="16"
                        FontWeight="DemiBold"
                        Text="{lex:Loc ClassicMode}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{lex:Loc ClassicModeDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsClassicMode, Mode=TwoWay}" />
            </Grid>
        </Border>
        <Border Margin="0,10,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock
                        FontSize="16"
                        FontWeight="DemiBold"
                        Text="{lex:Loc BpuiFileAssociation}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{lex:Loc BpuiFileAssociationDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding AssociateBpuiFiles, Mode=TwoWay}" />
            </Grid>
        </Border>
        <Border Margin="0,10,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock
                        FontSize="16"
                        FontWeight="DemiBold"
                        Text="{lex:Loc PageTransitionAnimation}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{lex:Loc PageTransitionAnimationDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsPageTransitionAnimationEnabled, Mode=TwoWay}" />
            </Grid>
        </Border>

        <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Title}"
            Text="教程与导览" />
        <Border Margin="0,10,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="首次启动导览与页面教程" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="可以重新启动首次导览，或清空所有页面教程、总导览和 CoveredByFlow 记录。"
                    TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0">
                    <ui:Button
                        Margin="0,0,10,10"
                        Command="{Binding RestartFirstRunTutorialCommand}"
                        Content="重新启动首次导览"
                        Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" />
                    <ui:Button
                        Margin="0,0,10,10"
                        Command="{Binding ResetAllTutorialStateCommand}"
                        Content="重置全部教程状态"
                        Icon="{ui:SymbolIcon Symbol=Delete24}" />
                    <ui:Button
                        Margin="0,0,10,10"
                        Command="{Binding RunRealTargetProbeTutorialCommand}"
                        Content="运行真实目标验证"
                        Icon="{ui:SymbolIcon Symbol=Play24}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Title}"
            Text="{lex:Loc SmartBpModuleSettingsTitle}" />
        <Border Margin="0,10,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="{lex:Loc SmartBpModulePath}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{lex:Loc SmartBpModulePathDescription}"
                    TextWrapping="Wrap" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        MinWidth="320"
                        VerticalAlignment="Center"
                        Text="{Binding SmartBpModuleRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding BrowseSmartBpModuleRootCommand}"
                        Content="{lex:Loc SmartBpModuleBrowseFolder}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <ui:Button
                        Margin="0,0,10,0"
                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                        Command="{Binding SaveSmartBpModuleRootCommand}"
                        Content="{lex:Loc Save}"
                        Icon="{ui:SymbolIcon Symbol=Save24}" />
                    <ui:Button
                        Margin="0,0,10,0"
                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                        Command="{Binding ResetSmartBpModuleRootCommand}"
                        Content="{lex:Loc ResetToBuiltIn}"
                        Icon="{ui:SymbolIcon Symbol=ArrowReset24}" />
                    <ui:Button
                        Margin="0,0,10,0"
                        Command="{Binding ImportSmartBpModuleArchiveCommand}"
                        Content="{lex:Loc SmartBpModuleImportArchive}"
                        Icon="{ui:SymbolIcon Symbol=Archive24}" />
                    <ui:Button
                        Margin="0,0,10,0"
                        Command="{Binding ToggleSmartBpVersionOutdatedDebugCommand}"
                        Content="调试：切换版本过旧状态"
                        Icon="{ui:SymbolIcon Symbol=Bug24}"
                        Visibility="{Binding IsDebugBuild, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding SmartBpModulePathStatus}" />
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        Margin="10,0,0,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsModuleExtracting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Title}"
            Text="{lex:Loc GameStateSaveSettingsTitle}" />
        <Border Margin="0,10,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="{lex:Loc GameStateSaveDirectory}" />
                <TextBlock
                    Margin="0,6,0,10"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{lex:Loc GameStateSaveDirectoryDescription}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        MinWidth="320"
                        VerticalAlignment="Center"
                        Text="{Binding GameStateSaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding BrowseGameStateSaveDirectoryCommand}"
                        Content="{lex:Loc BrowseGameStateSaveDirectory}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Title}"
            Text="{lex:Loc QuickAccess}" />
        <Border
            Margin="0,10,0,0"
            Padding="10,10,0,0"
            Style="{StaticResource Card}">
            <WrapPanel>
                <ui:Button
                    Margin="0,0,10,10"
                    Command="{Binding HopToConfigDirCommand}"
                    Content="{lex:Loc OpenFrontendDirectory}"
                    Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                <ui:Button
                    Margin="0,0,10,10"
                    Command="{Binding HopToGameOutputDirCommand}"
                    Content="{lex:Loc OpenGameFileDirectory}"
                    Icon="{ui:SymbolIcon Symbol=Games24}" />
            </WrapPanel>
        </Border>
        <ui:CardExpander Margin="0,10,0,0" Icon="{ui:SymbolIcon Symbol=Star24}">
            <ui:CardExpander.Header>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{lex:Loc ContributorList}" />
            </ui:CardExpander.Header>
            <StackPanel
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Orientation="Vertical">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource {x:Type ui:Image}}" TargetType="ui:Image">
                        <Setter Property="Height" Value="50" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,5,0" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="3" />
                    </Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <StackPanel>
                    <ui:Image Source="/Assets/Contributors/plfjy.png" />
                    <TextBlock Text="零风PLFJY" />
                    <TextBlock Text="软件主要作者" />
                </StackPanel>
                <StackPanel>
                    <ui:Image Source="/Assets/Contributors/zack.jpg" />
                    <TextBlock Text="Zack" />
                    <TextBlock Text="测试" />
                    <TextBlock Text="对局引导" />
                    <TextBlock Text="多语言" />
                    <TextBlock Text="使用文档" />
                </StackPanel>
                <StackPanel>
                    <ui:Image Source="/Assets/Contributors/tianqi.jpg" />
                    <TextBlock Text="天启" />
                    <TextBlock Text="插件系统" />
                </StackPanel>
                <StackPanel>
                    <ui:Image Source="/Assets/Contributors/zhangzhilv.jpg" />
                    <TextBlock Text="张之律" />
                    <TextBlock Text="提供了2025秋季赛规则软件 1.3 版本的UI" />
                </StackPanel>
                <StackPanel>
                    <ui:Image Source="/Assets/Contributors/tp.jpg" />
                    <TextBlock Text="tp" />
                    <TextBlock Text="提供了 2.0 版本的默认 UI" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardExpander Margin="0,10,0,0" Icon="{ui:SymbolIcon Symbol=Heart24}">
            <ui:CardExpander.Header>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{lex:Loc Sponsor}" />
            </ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Margin="0,10,0,0" TextWrapping="WrapWithOverflow">
                        <Run>neo-bpsys-wpf 软件本身是</Run>
                        <Run Foreground="Red">完全开源和免费</Run>
                        <Run>
                            的。
                        </Run>
                        <LineBreak />
                        <Run>
                            我，零风PLFJY 制作的BP软件切实帮助到了很多的民间赛事团队，从 idv-bp-asg-e 到 bp-sys-wpf 项目一路走来，感谢大家的支持。
                            同时维护如此庞大的项目和开发新功能也需要一定的支持才能更加持久的延续。（高中生时间不多，拖更严重致歉）
                        </Run>
                        <LineBreak />
                    </TextBlock>
                    <TextBlock TextWrapping="WrapWithOverflow">
                        <Run>
                            如果你是个人用户，并且享受到了本工具所带来的便利和帮助，请考虑捐赠以示感谢（就当是请我喝杯奶茶），
                            本软件的开发人员和ASG赛事组的成员将对此表示感谢！
                        </Run>
                    </TextBlock>
                </StackPanel>
                <ui:Image
                    Grid.Column="1"
                    Height="350"
                    HorizontalAlignment="Right"
                    CornerRadius="8"
                    Source="/Assets/donate_QR_code.png" />
            </Grid>
        </ui:CardExpander>
        <TextBlock
            Margin="0,10,0,0"
            Style="{StaticResource Title}"
            Text="{lex:Loc DebugOptions}" />
        <Border
            Margin="0,10,0,0"
            Padding="10,10,0,0"
            Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Margin="0,0,10,10" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{lex:Loc LogLevel}" />
                    <ComboBox
                        Width="220"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding IsLogLevelConfigurable}"
                        ItemsSource="{Binding LogLevelOptions}"
                        SelectedValue="{Binding SelectedLogLevel, Mode=TwoWay}"
                        SelectedValuePath="Value">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Settings" Text="{lex:Loc {Binding Key}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,10" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{lex:Loc ProductTourDebugger}" />
                    <ui:ToggleSwitch
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsProductTourDebugEnabled, Mode=TwoWay}" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button
                        Margin="0,0,10,10"
                        Command="{Binding ManualGcCommand}"
                        Content="{lex:Loc TriggerGCCollectionManually}" />
                    <ui:Button
                        Margin="0,0,10,10"
                        Command="{Binding OpenTipCommand}"
                        Content="打开启动时 SnackBar 提示" />
                    <ui:Button
                        Margin="0,0,10,10"
                        Command="{Binding HopToLogDirCommand}"
                        Content="{lex:Loc OpenLogDirectory}"
                        Icon="{ui:SymbolIcon Symbol=DocumentText24}" />
                    <ui:Button
                        Margin="0,0,10,10"
                        Command="{Binding OpenBehaviorEventDebuggerCommand}"
                        Content="{lex:Loc OpenBehaviorEventDebugger}"
                        Icon="{ui:SymbolIcon Symbol=Bug24}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
