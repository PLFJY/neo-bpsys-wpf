<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:neo_bpsys_wpf.Controls"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style TargetType="{x:Type control:DeleteConfirmationButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type control:DeleteConfirmationButton}">
                    <Grid>
                        <ui:Button
                            x:Name="PART_TriggerButton"
                            Background="PaleVioletRed"
                            Content="{TemplateBinding ButtonText}"
                            Icon="{ui:SymbolIcon Symbol=Delete24}" />
                        <ui:Flyout
                            Margin="0,0,0,10"
                            IsOpen="{Binding IsConfirmationOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Top">
                            <StackPanel Width="280">
                                <ui:TextBlock
                                    FontSize="14"
                                    Text="{TemplateBinding ConfirmationText}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        x:Name="PART_CancelButton"
                                        Margin="0,0,8,0"
                                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                        Content="{lex:Loc Cancel}"
                                        Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                                    <ui:Button
                                        x:Name="PART_ConfirmButton"
                                        Appearance="Danger"
                                        lex:ResxLocalizationProvider.DefaultDictionary="neo_bpsys_wpf.Locales.Common"
                                        Command="{TemplateBinding Command}"
                                        CommandParameter="{TemplateBinding CommandParameter}"
                                        Content="{lex:Loc Delete}"
                                        Icon="{ui:SymbolIcon Symbol=Delete24}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Flyout>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
