        <BuiltinPlugin Include="..\Built-inPlugins\neo-bpsys-wpf.TeamJsonMaker\neo-bpsys-wpf.TeamJsonMaker.csproj">
            <FolderName>top.plfjy.bpsys.TeamJsonMaker</FolderName>
            <PluginTargetFramework>net10.0-windows</PluginTargetFramework>
        </BuiltinPlugin>
        <BuiltinPlugin Include="..\Built-inPlugins\neo-bpsys-wpf.WebRenderer\neo-bpsys-wpf.WebRenderer.csproj">
            <FolderName>top.plfjy.bpsys.WebRenderer</FolderName>
            <PluginTargetFramework>net10.0-windows</PluginTargetFramework>
        </BuiltinPlugin>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)'=='Debug'">
