    <!-- 1) Build plugins before main Build. Do not restore here; callers control restore explicitly. -->
    <Target Name="BuildBuiltinPlugins" BeforeTargets="Build" Condition="@(BuiltinPlugin) != ''">
        <MSBuild Projects="@(BuiltinPlugin)" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration)" />
    </Target>

    <Target Name="BuildSmartBpModuleForDebug" BeforeTargets="Build" Condition="'$(Configuration)'=='Debug'">
        <MSBuild Projects="..\neo-bpsys-wpf.SmartBp.Module\neo-bpsys-wpf.SmartBp.Module.csproj" Targets="Build" Properties="Configuration=Debug" />
    </Target>

    <!-- Build: copy plugins into bin\<cfg>\<tfm>\Plugins\... -->
    <Target Name="CopyBuiltinPluginsToOutput_Build" AfterTargets="Build" Condition="@(BuiltinPlugin) != ''">
        <PropertyGroup>
            <PluginsOutDir>$(TargetDir)Plugins\</PluginsOutDir>
        </PropertyGroup>

        <ItemGroup>
            <_WebRendererBuiltinPlugin Include="@(BuiltinPlugin)" Condition="'%(BuiltinPlugin.FolderName)' == 'top.plfjy.bpsys.WebRenderer'" />
        </ItemGroup>
        <RemoveDir Directories="@(_WebRendererBuiltinPlugin->'$(PluginsOutDir)%(FolderName)\')" />

        <!-- 检测 WebRenderer 前端是否构建成功（Host wwwroot 是否存在）；缺失则跳过整个插件，避免打包残缺插件 -->
        <PropertyGroup Condition="@(_WebRendererBuiltinPlugin) != ''">
            <_WebRendererPluginRoot>$([System.IO.Path]::GetDirectoryName('%(_WebRendererBuiltinPlugin.FullPath)'))</_WebRendererPluginRoot>
            <_WebRendererHostWwwroot Condition="'$(RuntimeIdentifier)' != ''">$(_WebRendererPluginRoot)\bin\$(Configuration)\%(_WebRendererBuiltinPlugin.PluginTargetFramework)\$(RuntimeIdentifier)\Host\wwwroot</_WebRendererHostWwwroot>
            <_WebRendererHostWwwroot Condition="'$(RuntimeIdentifier)' == ''">$(_WebRendererPluginRoot)\bin\$(Configuration)\%(_WebRendererBuiltinPlugin.PluginTargetFramework)\Host\wwwroot</_WebRendererHostWwwroot>
            <_WebRendererFrontendReady Condition="Exists('$(_WebRendererHostWwwroot)')">true</_WebRendererFrontendReady>
        </PropertyGroup>
        <Warning Condition="@(_WebRendererBuiltinPlugin) != '' And '$(_WebRendererFrontendReady)' != 'true'" Text="WebRenderer 前端未构建（pnpm 不可用或构建失败），跳过复制 WebRenderer 插件到主程序输出目录。主程序构建继续。" />
        <ItemGroup Condition="@(_WebRendererBuiltinPlugin) != '' And '$(_WebRendererFrontendReady)' != 'true'">
            <BuiltinPlugin Remove="@(_WebRendererBuiltinPlugin)" />
        </ItemGroup>

        <MakeDir Directories="@(BuiltinPlugin->'$(PluginsOutDir)%(FolderName)\')" />

        <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
            <_PluginFiles Include="$([System.IO.Path]::GetDirectoryName('%(BuiltinPlugin.FullPath)'))\bin\$(Configuration)\%(BuiltinPlugin.PluginTargetFramework)\$(RuntimeIdentifier)\**\*.*">
                <FolderName>%(BuiltinPlugin.FolderName)</FolderName>
            </_PluginFiles>
        </ItemGroup>

        <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
            <_PluginFiles Include="$([System.IO.Path]::GetDirectoryName('%(BuiltinPlugin.FullPath)'))\bin\$(Configuration)\%(BuiltinPlugin.PluginTargetFramework)\**\*.*">
                <FolderName>%(BuiltinPlugin.FolderName)</FolderName>
            </_PluginFiles>
        </ItemGroup>

        <Copy SourceFiles="@(_PluginFiles)" DestinationFiles="@(_PluginFiles->'$(PluginsOutDir)%(FolderName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <!-- Publish: copy plugins into publish output Plugins\... -->
    <Target Name="CopyBuiltinPluginsToOutput_Publish" AfterTargets="Publish" Condition="@(BuiltinPlugin) != ''">
        <PropertyGroup>
            <PluginsOutDir>$(PublishDir)Plugins\</PluginsOutDir>
        </PropertyGroup>

        <ItemGroup>
            <_WebRendererBuiltinPlugin Include="@(BuiltinPlugin)" Condition="'%(BuiltinPlugin.FolderName)' == 'top.plfjy.bpsys.WebRenderer'" />
        </ItemGroup>
        <RemoveDir Directories="@(_WebRendererBuiltinPlugin->'$(PluginsOutDir)%(FolderName)\')" />

        <!-- 检测 WebRenderer 前端是否构建成功（Host wwwroot 是否存在）；缺失则跳过整个插件，避免打包残缺插件 -->
        <PropertyGroup Condition="@(_WebRendererBuiltinPlugin) != ''">
            <_WebRendererPluginRoot>$([System.IO.Path]::GetDirectoryName('%(_WebRendererBuiltinPlugin.FullPath)'))</_WebRendererPluginRoot>
            <_WebRendererHostWwwroot Condition="'$(RuntimeIdentifier)' != ''">$(_WebRendererPluginRoot)\bin\$(Configuration)\%(_WebRendererBuiltinPlugin.PluginTargetFramework)\$(RuntimeIdentifier)\Host\wwwroot</_WebRendererHostWwwroot>
            <_WebRendererHostWwwroot Condition="'$(RuntimeIdentifier)' == ''">$(_WebRendererPluginRoot)\bin\$(Configuration)\%(_WebRendererBuiltinPlugin.PluginTargetFramework)\Host\wwwroot</_WebRendererHostWwwroot>
            <_WebRendererFrontendReady Condition="Exists('$(_WebRendererHostWwwroot)')">true</_WebRendererFrontendReady>
        </PropertyGroup>
        <Warning Condition="@(_WebRendererBuiltinPlugin) != '' And '$(_WebRendererFrontendReady)' != 'true'" Text="WebRenderer 前端未构建（pnpm 不可用或构建失败），跳过复制 WebRenderer 插件到主程序输出目录。主程序构建继续。" />
        <ItemGroup Condition="@(_WebRendererBuiltinPlugin) != '' And '$(_WebRendererFrontendReady)' != 'true'">
            <BuiltinPlugin Remove="@(_WebRendererBuiltinPlugin)" />
        </ItemGroup>

        <MakeDir Directories="@(BuiltinPlugin->'$(PluginsOutDir)%(FolderName)\')" />

        <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
            <_PluginFiles Include="$([System.IO.Path]::GetDirectoryName('%(BuiltinPlugin.FullPath)'))\bin\$(Configuration)\%(BuiltinPlugin.PluginTargetFramework)\$(RuntimeIdentifier)\**\*.*">
                <FolderName>%(BuiltinPlugin.FolderName)</FolderName>
            </_PluginFiles>
        </ItemGroup>

        <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
            <_PluginFiles Include="$([System.IO.Path]::GetDirectoryName('%(BuiltinPlugin.FullPath)'))\bin\$(Configuration)\%(BuiltinPlugin.PluginTargetFramework)\**\*.*">
                <FolderName>%(BuiltinPlugin.FolderName)</FolderName>
            </_PluginFiles>
        </ItemGroup>

        <Copy SourceFiles="@(_PluginFiles)" DestinationFiles="@(_PluginFiles->'$(PluginsOutDir)%(FolderName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>



